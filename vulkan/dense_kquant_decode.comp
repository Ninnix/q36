#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#if defined(Q36_Q2K_ONLY) || defined(Q36_Q4K_ONLY) || defined(Q36_Q5K_ONLY)
layout(set = 0, binding = 0) readonly buffer Weights { uint ww[]; };
#else
layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
#endif
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
#ifdef Q36_I16
layout(set = 0, binding = 3) readonly buffer Raw { uint raw_values[]; };
#endif
#ifdef Q36_HEAD_MASK
layout(set = 0, binding = 3) readonly buffer Mask { uint ages[]; };
#endif

#ifndef Q36_TOKENS
#define Q36_TOKENS 1
#endif

#if Q36_TOKENS > 1
layout(constant_id = 0) const uint N_TOKENS = Q36_TOKENS;
#endif

layout(push_constant) uniform Push {
    uint in_dim;
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    uint type;
    float scale;
} pc;

const uint Q2_K = 10u;
const uint Q3_K = 11u;
const uint Q4_K = 12u;
const uint Q5_K = 13u;
const uint Q6_K = 14u;
#ifndef Q36_BOUNDS
#define Q36_BOUNDS 1
#endif
#ifndef Q36_ROWS
#define Q36_ROWS 4
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;

#ifdef Q36_Q2K_ONLY
#define QTYPE Q2_K
#elif defined(Q36_Q6K_ONLY)
#define QTYPE Q6_K
#elif defined(Q36_Q3K_ONLY)
#define QTYPE Q3_K
#elif defined(Q36_Q4K_ONLY)
#define QTYPE Q4_K
#elif defined(Q36_Q5K_ONLY)
#define QTYPE Q5_K
#else
#define QTYPE pc.type
#endif

uint load_u8(uint off) {
#if defined(Q36_Q2K_ONLY) || defined(Q36_Q4K_ONLY) || defined(Q36_Q5K_ONLY)
    return (ww[off >> 2u] >> ((off & 3u) * 8u)) & 255u;
#else
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
#endif
}

uint load_u32(uint off) {
#if defined(Q36_Q2K_ONLY) || defined(Q36_Q4K_ONLY) || defined(Q36_Q5K_ONLY)
    return ww[off >> 2u];
#else
    uint i = off >> 1u;
    return uint(wh[i]) | (uint(wh[i + 1u]) << 16u);
#endif
}

int load_i8(uint off) {
    return bitfieldExtract(int(load_u8(off)), 0, 8);
}

float load_f16(uint off) {
#if defined(Q36_Q2K_ONLY) || defined(Q36_Q4K_ONLY) || defined(Q36_Q5K_ONLY)
    return unpackHalf2x16(ww[off >> 2u] >> ((off & 2u) * 8u)).x;
#else
    return unpackHalf2x16(uint(wh[off >> 1u])).x;
#endif
}

void k4_scale_min(uint base, uint j, out uint sc, out uint mn) {
    uint s0 = load_u8(base + 4u + j);
    if (j < 4u) {
        sc = s0 & 63u;
        mn = load_u8(base + 8u + j) & 63u;
    } else {
        uint s1 = load_u8(base + 8u + j);
        uint s2 = load_u8(base + j);
        sc = (s1 & 15u) | ((s2 >> 6u) << 4u);
        mn = (s1 >> 4u) | ((s0 >> 6u) << 4u);
    }
}

uint q2_value(uint base, uint idx) {
    uint in_idx = idx & 127u;
    uint off = base + 16u + (idx >> 7u) * 32u + (in_idx & 31u);
    return (load_u8(off) >> ((in_idx >> 5u) * 2u)) & 3u;
}

int q3_scale(uint base, uint group) {
    uint lo = load_u8(base + 96u + (group & 7u));
    lo = group < 8u ? lo & 15u : lo >> 4u;
    uint hi = (load_u8(base + 104u + (group & 3u)) >>
               (2u * (group >> 2u))) & 3u;
    return int(lo | (hi << 4u)) - 32;
}

int q3_value(uint base, uint idx) {
    uint half_id = idx >> 7u;
    uint group = (idx & 127u) >> 4u;
    uint q = load_u8(base + 32u + half_id * 32u + (idx & 31u));
    uint m = 1u << (half_id * 4u + (group >> 1u));
    uint lo = (q >> (2u * (group >> 1u))) & 3u;
    return int(lo) - ((load_u8(base + (idx & 31u)) & m) != 0u ? 0 : 4);
}

uint q4_value(uint base, uint idx) {
    uint g = idx >> 5u;
    uint v = load_u8(base + 16u + (g >> 1u) * 32u + (idx & 31u));
    return (g & 1u) == 0u ? v & 15u : v >> 4u;
}

uint q5_value(uint base, uint idx) {
    uint g = idx >> 5u;
    uint i = idx & 31u;
    uint v = load_u8(base + 48u + (g >> 1u) * 32u + i);
    uint lo = (g & 1u) == 0u ? v & 15u : v >> 4u;
    return lo | (((load_u8(base + 16u + i) >> g) & 1u) << 4u);
}

uint q6_value(uint base, uint idx) {
    uint half_block = idx >> 7u;
    uint in_idx = idx & 127u;
    uint l = in_idx & 31u;
    uint sel = in_idx >> 5u;
    uint off = half_block * 64u + ((sel & 1u) != 0u ? 32u : 0u) + l;
    uint low = sel < 2u ? load_u8(base + off) & 15u : load_u8(base + off) >> 4u;
    uint hi = (load_u8(base + 128u + half_block * 32u + l) >> (2u * sel)) & 3u;
    return low | (hi << 4u);
}

vec4 dequant_word(uint row, uint block, uint word) {
    uint idx = 4u * word;
    uint base = row * pc.row_bytes;
    vec4 qv;
    if (QTYPE == Q2_K) {
        base += 84u * block;
        uint group = idx >> 4u;
        qv = vec4(q2_value(base, idx), q2_value(base, idx + 1u),
                  q2_value(base, idx + 2u), q2_value(base, idx + 3u));
        return load_f16(base + 80u) * float(load_u8(base + group) & 15u) * qv -
               load_f16(base + 82u) * float(load_u8(base + group) >> 4u);
    }
    if (QTYPE == Q3_K) {
        base += 110u * block;
        uint half_id = idx >> 7u;
        uint group = (idx & 127u) >> 4u;
        uint shift = 2u * (group >> 1u);
        uint m = 1u << (half_id * 4u + (group >> 1u));
        uint qs = (load_u32(base + 32u + half_id * 32u + (idx & 31u)) >> shift) &
                  0x03030303u;
        uint hm = load_u32(base + (idx & 31u));
        qv = vec4(float(qs & 255u), float((qs >> 8u) & 255u),
                  float((qs >> 16u) & 255u), float(qs >> 24u)) -
             4.0 * vec4((hm & (m << 0u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 8u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 16u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 24u)) != 0u ? 0.0 : 1.0);
        return load_f16(base + 108u) * float(q3_scale(base, idx >> 4u)) * qv;
    }
    if (QTYPE == Q4_K || QTYPE == Q5_K) {
        base += (QTYPE == Q4_K ? 144u : 176u) * block;
        uint sc;
        uint mn;
        k4_scale_min(base, idx >> 5u, sc, mn);
        qv = QTYPE == Q4_K ?
            vec4(q4_value(base, idx), q4_value(base, idx + 1u),
                 q4_value(base, idx + 2u), q4_value(base, idx + 3u)) :
            vec4(q5_value(base, idx), q5_value(base, idx + 1u),
                 q5_value(base, idx + 2u), q5_value(base, idx + 3u));
        return load_f16(base) * float(sc) * qv - load_f16(base + 2u) * float(mn);
    }
    base += 210u * block;
    uint half_block = idx >> 7u;
    uint in_idx = idx & 127u;
    uint l = in_idx & 31u;
    uint sel = in_idx >> 5u;
    uint ql_off = half_block * 64u + ((sel & 1u) != 0u ? 32u : 0u) + l;
    uint ql = load_u32(base + ql_off);
    uint qh = load_u32(base + 128u + half_block * 32u + l);
    uint low = sel < 2u ? ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
    uint packed = low | (((qh >> (2u * sel)) & 0x03030303u) << 4u);
    qv = vec4(float(packed & 255u), float((packed >> 8u) & 255u),
              float((packed >> 16u) & 255u), float(packed >> 24u)) - 32.0;
    return load_f16(base + 208u) *
           float(load_i8(base + 192u + (idx >> 4u))) * qv;
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

#if Q36_TOKENS == 1
#if defined(Q36_INT_DOT) || defined(Q36_Q2K_ONLY)
#define SCALAR_UNROLL [[unroll]]
#else
#define SCALAR_UNROLL
#endif

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 15u;
    uint first_row = gl_WorkGroupID.x * ROWS;
#ifdef Q36_HEAD_MASK
    if (ages[first_row / 64u] == 0u) {
        if (lid < ROWS && first_row + lid < pc.out_dim)
            y[first_row + lid] = uintBitsToFloat(0xff800000u);
        return;
    }
#endif
    float acc[ROWS];
    SCALAR_UNROLL for (uint r = 0u; r < ROWS; r++) acc[r] = 0.0;

    SCALAR_UNROLL for (uint b = lid >> 4u; b < pc.blocks; b += 4u) {
#ifdef Q36_INT_DOT
        int qvec[4];
        SCALAR_UNROLL for (uint i = 0u; i < 4u; i++)
            qvec[i] = int(q8[b * Q8K_WORDS + 2u + 4u * itid + i]);
#else
        vec4 qvec[4];
        SCALAR_UNROLL for (uint i = 0u; i < 4u; i++)
            qvec[i] = unpack_i8(q8[b * Q8K_WORDS + 2u + 4u * itid + i]);
#endif
        float qsum = 0.0;
        if (QTYPE == Q4_K || QTYPE == Q5_K || QTYPE == Q6_K) {
#ifdef Q36_INT_DOT
            /* Q8_K stores the exact sum of these sixteen activation bytes. */
            uint sums = q8[b * Q8K_WORDS + 66u + (itid >> 1u)];
            qsum = float(bitfieldExtract(int(sums), int((itid & 1u) * 16u), 16));
#else
            SCALAR_UNROLL for (uint i = 0u; i < 4u; i++)
                qsum += qvec[i].x + qvec[i].y + qvec[i].z + qvec[i].w;
#endif
        }
        float yd = uintBitsToFloat(q8[b * Q8K_WORDS]);
        SCALAR_UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            if (QTYPE == Q4_K) {
                uint base = row * pc.row_bytes + 144u * b;
                uint group = itid >> 1u;
                uint sc;
                uint mn;
                k4_scale_min(base, group, sc, mn);
                float qdot = 0.0;
                SCALAR_UNROLL for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint ql = load_u32(base + 16u + (group >> 1u) * 32u +
                                       (idx & 31u));
                    uint packed = (group & 1u) == 0u ?
                        ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
#ifdef Q36_INT_DOT
                    qdot += float(dotPacked4x8EXT(int(packed), qvec[i]));
#else
                    vec4 xv = qvec[i];
                    qdot += dot(unpack_i8(packed), xv);
#endif
                }
                float part = load_f16(base) * float(sc) * qdot -
                             load_f16(base + 2u) * float(mn) * qsum;
                acc[r] = fma(yd, part, acc[r]);
                continue;
            }
            if (QTYPE == Q3_K) {
                uint base = row * pc.row_bytes + 110u * b;
                int sc = q3_scale(base, itid);
                uint half_id = itid >> 3u;
                uint group = itid & 7u;
                uint shift = 2u * (group >> 1u);
                uint m = 1u << (half_id * 4u + (group >> 1u));
                float qdot = 0.0;
                SCALAR_UNROLL for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint qs = (load_u32(base + 32u + half_id * 32u + (idx & 31u)) >> shift) &
                              0x03030303u;
                    uint hm = load_u32(base + (idx & 31u));
#ifdef Q36_INT_DOT
                    uint negative = ((hm >> (half_id * 4u + (group >> 1u))) & 0x01010101u) ^ 0x01010101u;
                    uint packed = qs | (negative * 252u);
                    qdot += float(dotPacked4x8EXT(int(packed), qvec[i]));
#else
                    vec4 wv = vec4(float(qs & 255u), float((qs >> 8u) & 255u),
                                   float((qs >> 16u) & 255u), float(qs >> 24u)) -
                        4.0 * vec4((hm & (m << 0u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 8u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 16u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 24u)) != 0u ? 0.0 : 1.0);
                    qdot += dot(wv, qvec[i]);
#endif
                }
                acc[r] = fma(yd * load_f16(base + 108u) * float(sc), qdot, acc[r]);
                continue;
            }
            if (QTYPE == Q5_K) {
                uint base = row * pc.row_bytes + 176u * b;
                uint group = itid >> 1u;
                uint sc;
                uint mn;
                k4_scale_min(base, group, sc, mn);
                float qdot = 0.0;
                SCALAR_UNROLL for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint ql = load_u32(base + 48u + (group >> 1u) * 32u +
                                       (idx & 31u));
                    uint low = (group & 1u) == 0u ?
                        ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
                    uint qh = load_u32(base + 16u + (idx & 31u));
                    uint packed = low | (((qh >> group) & 0x01010101u) << 4u);
#ifdef Q36_INT_DOT
                    qdot += float(dotPacked4x8EXT(int(packed), qvec[i]));
#else
                    qdot += dot(unpack_i8(packed), qvec[i]);
#endif
                }
                float part = load_f16(base) * float(sc) * qdot -
                             load_f16(base + 2u) * float(mn) * qsum;
                acc[r] = fma(yd, part, acc[r]);
                continue;
            }
            if (QTYPE == Q6_K) {
                uint base = row * pc.row_bytes + 210u * b;
                float qdot = 0.0;
                SCALAR_UNROLL for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint half_block = idx >> 7u;
                    uint in_idx = idx & 127u;
                    uint l = in_idx & 31u;
                    uint sel = in_idx >> 5u;
                    uint ql_off = half_block * 64u +
                        ((sel & 1u) != 0u ? 32u : 0u) + l;
                    uint ql = load_u32(base + ql_off);
                    uint qh = load_u32(base + 128u + half_block * 32u + l);
                    uint low = sel < 2u ? ql & 0x0f0f0f0fu :
                                           (ql >> 4u) & 0x0f0f0f0fu;
                    uint packed = low |
                        (((qh >> (2u * sel)) & 0x03030303u) << 4u);
#ifdef Q36_INT_DOT
                    qdot += float(dotPacked4x8EXT(int(packed), qvec[i]));
#else
                    vec4 xv = qvec[i];
                    qdot += dot(vec4(float(packed & 255u),
                                     float((packed >> 8u) & 255u),
                                     float((packed >> 16u) & 255u),
                                     float(packed >> 24u)), xv);
#endif
                }
                float part = load_f16(base + 208u) *
                             float(load_i8(base + 192u + itid)) *
                             (qdot - 32.0 * qsum);
                acc[r] = fma(yd, part, acc[r]);
                continue;
            }
            if (QTYPE == Q2_K) {
                /* Gather four coefficients per word and share the scales
                 * across sixteen values, retaining the original float dot. */
                uint base = row * pc.row_bytes + 84u * b;
                uint scale = load_u8(base + itid);
                float d = load_f16(base + 80u) * float(scale & 15u);
                float m = load_f16(base + 82u) * float(scale >> 4u);
                uint shift = 2u * ((itid & 7u) >> 1u);
                float part = 0.0;
                SCALAR_UNROLL for (uint i = 0u; i < 4u; i++) {
                    uint off = base + 16u + (itid >> 3u) * 32u + (itid & 1u) * 16u + i * 4u;
                    uint packed = (load_u32(off) >> shift) & 0x03030303u;
                    vec4 wv = d * unpack_i8(packed) - m;
#ifdef Q36_INT_DOT
                    part += dot(wv, unpack_i8(uint(qvec[i])));
#else
                    part += dot(wv, qvec[i]);
#endif
                }
                acc[r] = fma(yd, part, acc[r]);
                continue;
            }
            float part = 0.0;
            SCALAR_UNROLL for (uint i = 0u; i < 4u; i++)
                part += dot(dequant_word(row, b, 4u * itid + i),
#ifdef Q36_INT_DOT
                            unpack_i8(uint(qvec[i])));
#else
                            qvec[i]);
#endif
            acc[r] = fma(yd, part, acc[r]);
        }
    }

    SCALAR_UNROLL for (uint r = 0u; r < ROWS; r++) {
        float total = subgroupAdd(acc[r]);
        uint row = first_row + r;
        if (lid == 0u
#if Q36_BOUNDS
            && row < pc.out_dim
#endif
        ) y[row] = total * pc.scale;
    }
}
#else

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint part_id = lid & 15u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[N_TOKENS][ROWS];
#ifdef Q36_PREFILL
    uint tok0 = gl_WorkGroupID.y * N_TOKENS;
#else
    uint tok0 = 0u;
#endif
    [[unroll]] for (uint t = 0u; t < N_TOKENS; t++)
        [[unroll]] for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;

    for (uint b = lid >> 4u; b < pc.blocks; b += 4u) {
        [[unroll]] for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            vec4 w[4];
            int packed_w[4];
            float wd = 0.0, wm = 0.0, sc = 0.0, mn = 0.0;
            if (QTYPE == Q3_K) {
                uint base = row * pc.row_bytes + 110u * b;
                wd = load_f16(base + 108u);
                sc = float(q3_scale(base, part_id));
                uint half_id = part_id >> 3u, group = part_id & 7u;
                uint shift = 2u * (group >> 1u);
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * part_id + 4u * i;
                    uint qs = (load_u32(base + 32u + half_id * 32u + (idx & 31u)) >> shift) & 0x03030303u;
                    uint hm = load_u32(base + (idx & 31u));
                    uint negative = ((hm >> (half_id * 4u + (group >> 1u))) & 0x01010101u) ^ 0x01010101u;
                    packed_w[i] = int(qs | (negative * 252u));
                }
            } else if (QTYPE == Q4_K || QTYPE == Q5_K) {
                uint base = row * pc.row_bytes + (QTYPE == Q4_K ? 144u : 176u) * b;
                uint group = part_id >> 1u, scale, minimum;
                k4_scale_min(base, group, scale, minimum);
                wd = load_f16(base); wm = load_f16(base + 2u);
                sc = float(scale); mn = float(minimum);
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * part_id + 4u * i;
                    uint ql = load_u32(base + (QTYPE == Q4_K ? 16u : 48u) +
                                       (group >> 1u) * 32u + (idx & 31u));
                    uint packed = (group & 1u) == 0u ? ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
                    if (QTYPE == Q5_K) {
                        uint qh = load_u32(base + 16u + (idx & 31u));
                        packed |= ((qh >> group) & 0x01010101u) << 4u;
                    }
                    packed_w[i] = int(packed);
                }
            } else if (QTYPE == Q6_K) {
                uint base = row * pc.row_bytes + 210u * b;
                wd = load_f16(base + 208u);
                sc = float(load_i8(base + 192u + part_id));
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * part_id + 4u * i;
                    uint half_block = idx >> 7u, in_idx = idx & 127u;
                    uint l = in_idx & 31u, sel = in_idx >> 5u;
                    uint off = half_block * 64u + ((sel & 1u) != 0u ? 32u : 0u) + l;
                    uint ql = load_u32(base + off), qh = load_u32(base + 128u + half_block * 32u + l);
                    uint low = sel < 2u ? ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
                    uint packed = low | (((qh >> (2u * sel)) & 0x03030303u) << 4u);
                    packed_w[i] = int(packed);
                }
            } else {
                uint base = row * pc.row_bytes + 84u * b;
                uint scale = load_u8(base + part_id);
                float d = load_f16(base + 80u) * float(scale & 15u);
                float m = load_f16(base + 82u) * float(scale >> 4u);
                uint shift = 2u * ((part_id & 7u) >> 1u);
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    uint off = base + 16u + (part_id >> 3u) * 32u + (part_id & 1u) * 16u + i * 4u;
                    uint packed = (load_u32(off) >> shift) & 0x03030303u;
                    w[i] = d * unpack_i8(packed) - m;
                }
            }
#ifdef Q36_I16
            i16vec2 w16[8];
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                uint p = uint(packed_w[i]);
                int center = QTYPE == Q6_K ? 32 : 0;
                w16[2u*i] = i16vec2(int(p & 255u)-center,int((p >> 8u) & 255u)-center);
                w16[2u*i+1u] = i16vec2(int((p >> 16u) & 255u)-center,int(p >> 24u)-center);
            }
#endif
            [[unroll]] for (uint t = 0u; t < N_TOKENS; t++) {
                uint qbase = ((tok0 + t) * pc.blocks + b) * Q8K_WORDS;
                float yd = uintBitsToFloat(q8[qbase]);
                float qsum = 0.0, qdot = 0.0;
                if (QTYPE == Q2_K) {
                    [[unroll]] for (uint i = 0u; i < 4u; i++)
                        qdot += dot(w[i], unpack_i8(q8[qbase + 2u + 4u * part_id + i]));
                } else {
                    /* Q8_K already stores the exact sum of each sixteen bytes. */
                    uint sums = q8[qbase + 66u + (part_id >> 1u)];
                    int isum = bitfieldExtract(int(sums), int((part_id & 1u) * 16u), 16);
                    int idot = 0;
#ifdef Q36_I16
                    /* Widen before packed i16 partials can overflow. */
                    i16vec2 partial = i16vec2(0);
                    [[unroll]] for (uint i = 0u; i < 4u; i++) {
                        uint off = ((tok0+t)*pc.blocks+b)*128u+part_id*8u+2u*i;
                        partial += w16[2u*i] * unpackInt2x16(int(raw_values[off]));
                        partial += w16[2u*i+1u] * unpackInt2x16(int(raw_values[off+1u]));
                        if ((i & 1u) != 0u) {
                            idot += int(partial.x)+int(partial.y);
                            partial = i16vec2(0);
                        }
                    }
                    if (QTYPE == Q6_K) isum = 0;
#else
                    [[unroll]] for (uint i = 0u; i < 4u; i++) {
                        int q = int(q8[qbase + 2u + 4u * part_id + i]);
                        idot += dotPacked4x8EXT(packed_w[i], q);
                    }
#endif
                    qsum = float(isum);
                    qdot = float(idot);
                }
                if (QTYPE == Q3_K) acc[t][r] = fma(yd * wd * sc, qdot, acc[t][r]);
                else {
                    float part = QTYPE == Q4_K || QTYPE == Q5_K ? wd * sc * qdot - wm * mn * qsum :
                                 QTYPE == Q6_K ? wd * sc * (qdot - 32.0 * qsum) : qdot;
                    acc[t][r] = fma(yd, part, acc[t][r]);
                }
            }
        }
    }
    [[unroll]] for (uint t = 0u; t < N_TOKENS; t++) {
        [[unroll]] for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u
#if Q36_BOUNDS
                && row < pc.out_dim
#endif
            ) {
                y[(tok0 + t) * pc.out_dim + row] = total * pc.scale;
            }
        }
    }
}
#endif
