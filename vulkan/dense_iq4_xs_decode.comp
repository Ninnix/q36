#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    float scale;
} pc;

const uint ROWS = 4u;
const uint Q8K_WORDS = 74u;
const int values[16] = int[16](
    -127, -104, -83, -65, -49, -35, -22, -10,
       1,   13,  25,  38,  53,  69,  89, 113);
shared float value_lut[16];

uint load_u8(uint off) {
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
}

uint load_u16(uint off) {
    return uint(wh[off >> 1u]);
}

uint load_u32(uint off) {
    uint i = off >> 1u;
    return uint(wh[i]) | (uint(wh[i + 1u]) << 16u);
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

vec4 unpack_iq4(uint v, uint shift) {
    return vec4(value_lut[(v >> (shift + 0u)) & 15u],
                value_lut[(v >> (shift + 8u)) & 15u],
                value_lut[(v >> (shift + 16u)) & 15u],
                value_lut[(v >> (shift + 24u)) & 15u]);
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 15u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[ROWS];
    for (uint r = 0u; r < ROWS; r++) acc[r] = 0.0;
    if (lid < 16u) value_lut[lid] = float(values[lid]);
    barrier();

    for (uint b = lid >> 4u; b < pc.blocks; b += 4u) {
        uint qbase = b * Q8K_WORDS + 2u + 4u * itid;
        vec4 qv[4];
        for (uint l = 0u; l < 4u; l++) qv[l] = unpack_i8(q8[qbase + l]);
        float yd = uintBitsToFloat(q8[b * Q8K_WORDS]);
        uint ib = itid >> 1u;
        uint shift = 4u * (itid & 1u);

        for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
            if (row >= pc.out_dim) continue;
            uint base = row * pc.row_bytes + 136u * b;
            float sum = 0.0;
            for (uint l = 0u; l < 4u; l++)
                sum += dot(unpack_iq4(load_u32(base + 8u + 16u * ib + 4u * l), shift), qv[l]);
            uint sl = load_u8(base + 4u + ib / 2u);
            uint sh = load_u16(base + 2u);
            int ls = int((sl >> (4u * (ib & 1u))) & 15u) |
                     int(((sh >> (2u * ib)) & 3u) << 4u);
            float wd = unpackHalf2x16(load_u16(base)).x;
            acc[r] = fma(wd * yd * float(ls - 32), sum, acc[r]);
        }
    }

    for (uint r = 0u; r < ROWS; r++) {
        float total = subgroupAdd(acc[r]);
        uint row = first_row + r;
        if (lid == 0u && row < pc.out_dim) y[row] = total * pc.scale;
    }
}
