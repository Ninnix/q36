#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint ww[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
#ifdef Q36_HEAD_MASK
layout(set = 0, binding = 3) readonly buffer Mask { uint ages[]; };
#endif
#ifdef Q36_I16
layout(set = 0, binding = 3) readonly buffer Raw { uint raw_values[]; };
#endif

#ifndef Q36_TOKENS
#define Q36_TOKENS 1
#endif

#if Q36_TOKENS > 1
layout(constant_id = 0) const uint N_TOKENS = Q36_TOKENS;
#else
#define N_TOKENS 1
#endif

#if Q36_TOKENS > 1
#define UNROLL [[unroll]]
#else
#define UNROLL
#endif

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    float scale;
#if Q36_TOKENS > 1
    uint n_tok;
#endif
} pc;

#ifndef Q36_BOUNDS
#define Q36_BOUNDS 1
#endif
#ifndef Q36_ROWS
#define Q36_ROWS 4
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;
const int values[16] = int[16](
    -127, -104, -83, -65, -49, -35, -22, -10,
       1,   13,  25,  38,  53,  69,  89, 113);
#if Q36_TOKENS > 1
shared uint pair_lut[256];
#else
shared float value_lut[16];
#endif

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

#if Q36_TOKENS == 1
vec4 unpack_iq4(uint v, uint shift) {
    return vec4(value_lut[(v >> (shift + 0u)) & 15u],
                value_lut[(v >> (shift + 8u)) & 15u],
                value_lut[(v >> (shift + 16u)) & 15u],
                value_lut[(v >> (shift + 24u)) & 15u]);
}
#endif

#if Q36_TOKENS > 1
#ifdef Q36_I16
uvec2 packed_iq4(uint v, uint shift) {
    uint pairs = (v >> shift) & 0x0f0f0f0fu;
    pairs |= pairs >> 4u;
    return uvec2(pair_lut[pairs & 255u], pair_lut[(pairs >> 16u) & 255u]);
}
#else
int packed_iq4(uint v, uint shift) {
    uint pairs = (v >> shift) & 0x0f0f0f0fu;
    pairs |= pairs >> 4u;
    uint a = pairs & 255u;
    uint b = (pairs >> 16u) & 255u;
    return int(pair_lut[a] | (pair_lut[b] << 16u));
}
#endif
#endif

#ifdef Q36_IQ4_NL
uint load_word(uint offset) {
    uint shift = (offset & 3u) * 8u;
    uint word = ww[offset >> 2u];
    return shift == 0u ? word : (word >> shift) | (ww[(offset >> 2u)+1u] << (32u-shift));
}
#endif

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
#ifdef Q36_PREFILL
    uint tok0 = gl_WorkGroupID.y * N_TOKENS;
#else
    uint tok0 = 0u;
#endif
#ifdef Q36_HEAD_MASK
    if (ages[first_row / 64u] == 0u) {
        if (lid < ROWS && first_row + lid < pc.out_dim)
            y[first_row + lid] = uintBitsToFloat(0xff800000u);
        return;
    }
#endif
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;
#if Q36_TOKENS > 1
#ifdef Q36_I16
    for (uint i = lid; i < 256u; i += 64u)
        pair_lut[i] = uint(values[i & 15u] & 65535) |
                      (uint(values[i >> 4u] & 65535) << 16u);
#else
    /* A pair per lookup halves LDS reads while constructing the same bytes. */
    for (uint i = lid; i < 256u; i += 64u)
        pair_lut[i] = uint(values[i & 15u] & 255) | (uint(values[i >> 4u] & 255) << 8u);
#endif
#else
    if (lid < 16u) value_lut[lid] = float(values[lid]);
#endif
    barrier();

    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        uint qbase = b * Q8K_WORDS + 2u + 8u * itid;
#ifndef Q36_I16
#if Q36_TOKENS > 1
        int qv[N_TOKENS][8];
#else
        vec4 qv[N_TOKENS][8];
#endif
#endif
        float yd[N_TOKENS];
        UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
            uint offset = (tok0+t) * pc.blocks * Q8K_WORDS;
#ifndef Q36_I16
#if Q36_TOKENS > 1
            UNROLL for (uint l = 0u; l < 8u; l++) qv[t][l] = int(q8[offset + qbase + l]);
#else
            UNROLL for (uint l = 0u; l < 8u; l++) qv[t][l] = unpack_i8(q8[offset + qbase + l]);
#endif
#endif
            yd[t] = uintBitsToFloat(q8[offset + b * Q8K_WORDS]);
        }
        uint ib = itid;

        UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
#ifdef Q36_IQ4_NL
            uint base = row*pc.row_bytes+(b*8u+itid)*18u;
            uint meta0 = load_word(base);
#else
            uint base = (row * pc.row_bytes + 136u * b) >> 2u;
            uint meta0 = ww[base];
            uint meta1 = ww[base + 1u];
#endif
            /* These 32 byte products sum exactly in f32; packed integer dots
             * preserve the decode result before applying float scales. */
#if Q36_TOKENS > 1
            int sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0;
#else
            float sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0.0;
#endif
            UNROLL for (uint l = 0u; l < 4u; l++) {
#ifdef Q36_IQ4_NL
                uint packed = load_word(base+2u+4u*l);
#else
                uint packed = ww[base + 2u + 4u * ib + l];
#endif
#ifdef Q36_I16
                uvec2 w0 = packed_iq4(packed, 0u);
                uvec2 w1 = packed_iq4(packed, 4u);
#elif Q36_TOKENS > 1
                int w0 = packed_iq4(packed, 0u);
                int w1 = packed_iq4(packed, 4u);
#else
                vec4 w0 = unpack_iq4(packed, 0u);
                vec4 w1 = unpack_iq4(packed, 4u);
#endif
                UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
#ifdef Q36_I16
                    /* Two products per i16 lane fit even at 2 * 127 * 128.
                     * Widen each partial before adding low and high halves. */
                    uint raw = ((tok0+t) * pc.blocks + b) * 128u + 16u * itid + 2u * l;
                    i16vec2 a = unpackInt2x16(int(w0.x)) * unpackInt2x16(int(raw_values[raw]));
                    a += unpackInt2x16(int(w0.y)) * unpackInt2x16(int(raw_values[raw + 1u]));
                    i16vec2 c = unpackInt2x16(int(w1.x)) * unpackInt2x16(int(raw_values[raw + 8u]));
                    c += unpackInt2x16(int(w1.y)) * unpackInt2x16(int(raw_values[raw + 9u]));
                    sum[t] += int(a.x) + int(a.y) + int(c.x) + int(c.y);
#elif Q36_TOKENS > 1
                    sum[t] += dotPacked4x8EXT(w0, qv[t][l]);
                    sum[t] += dotPacked4x8EXT(w1, qv[t][l + 4u]);
#else
                    vec4 q0 = qv[t][l];
                    vec4 q1 = qv[t][l + 4u];
                    sum[t] = fma(w0.x, q0.x,
                          fma(w0.y, q0.y,
                          fma(w0.z, q0.z,
                          fma(w0.w, q0.w,
                          fma(w1.x, q1.x,
                          fma(w1.y, q1.y,
                          fma(w1.z, q1.z,
                          fma(w1.w, q1.w, sum[t]))))))));
#endif
                }
            }
#ifndef Q36_IQ4_NL
            uint sl = meta1 >> (8u * (ib >> 1u));
            uint sh = meta0 >> 16u;
            int ls = int((sl >> (4u * (ib & 1u))) & 15u) |
                     int(((sh >> (2u * ib)) & 3u) << 4u);
            float wd = unpackHalf2x16(meta0).x;
            UNROLL for (uint t = 0u; t < N_TOKENS; t++)
            acc[t][r] = fma(wd * yd[t] * float(ls - 32), float(sum[t]), acc[t][r]);
#else
            float wd = unpackHalf2x16(meta0).x;
            UNROLL for (uint t = 0u; t < N_TOKENS; t++)
                acc[t][r] = fma(yd[t],wd*float(sum[t]),acc[t][r]);
#endif
        }
    }

    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u
#if Q36_BOUNDS
                && row < pc.out_dim
#endif
            ) y[(tok0+t) * pc.out_dim + row] = total * pc.scale;
        }
    }
}
