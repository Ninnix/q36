#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint8_t wb[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

#ifndef Q36_TOKENS
#define Q36_TOKENS 1
#endif

#if Q36_TOKENS > 1
layout(constant_id = 0) const uint N_TOKENS = Q36_TOKENS;
#else
#define N_TOKENS Q36_TOKENS
#endif

#if Q36_TOKENS > 1
#define UNROLL [[unroll]]
#else
#define UNROLL
#endif

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    uint type;
    float scale;
#if Q36_TOKENS > 1
    uint n_tok;
#endif
} pc;

#ifdef Q36_TYPE
#define QTYPE Q36_TYPE
#else
#define QTYPE pc.type
#endif

const uint IQ2_XXS = 16u;
const uint IQ2_XS = 17u;
const uint IQ1_S = 19u;
const uint IQ4_NL = 20u;
const uint IQ2_S = 22u;
#ifndef Q36_ROWS
#define Q36_ROWS 4
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;
const uint TAB_IQ2XXS = 0u;
const uint TAB_KSIGNS_BYTES = 2048u;
const uint TAB_IQ2S = 544u;
const uint TAB_IQ1S = 3360u;
const uint TAB_IQ2XS = 7456u;

#if !defined(Q36_TYPE) || Q36_TYPE == 16 || Q36_TYPE == 17 || Q36_TYPE == 22
#define Q36_SIGN_LUT
shared uvec2 sign_lut[16];

void init_signs(void) {
    uint lid = gl_LocalInvocationID.x;
    if (lid < 16u) {
        uint bits = (lid * 0x00204081u) & 0x01010101u;
        sign_lut[lid] = uvec2(bits * 255u, bits);
    }
    barrier();
}
#endif

#ifdef Q36_ROUTED
layout(set = 0, binding = 4) readonly buffer Selected { uint selected[]; };
uint route_token, route_rank, route_expert;
void init_route(void) {
    route_token=gl_WorkGroupID.z; route_rank=gl_WorkGroupID.y;
    route_expert=selected[route_token*16384u+route_rank];
}
#define Q36_INIT_ROUTE init_route();
#else
#define Q36_INIT_ROUTE
#endif
uint input_word(uint off) {
#ifdef Q36_ROUTED
    off += route_token*16384u;
#endif
    return q8[off];
}
void store_output(uint token, uint row, float value) {
#ifdef Q36_ROUTED
    y[route_token*16384u+route_rank*pc.out_dim+row]=value;
#else
    y[token * pc.out_dim + row] = value;
#endif
}

uint weight_offset(uint off) {
#ifdef Q36_ROUTED
    off += route_expert*pc.out_dim*pc.row_bytes;
#endif
    return off;
}
uint load_u8(uint off) {
    return uint(wb[weight_offset(off)]);
}
uint load_u16(uint off) {
    off = weight_offset(off);
    return uint(wb[off]) | (uint(wb[off+1u]) << 8u);
}
uint load_u32(uint off) {
    off = weight_offset(off);
    return uint(wb[off]) | (uint(wb[off+1u]) << 8u) | (uint(wb[off+2u]) << 16u) | (uint(wb[off+3u]) << 24u);
}

uint table_u8(uint off) {
    return (tables[off >> 2u] >> (8u * (off & 3u))) & 255u;
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

vec4 signed_grid(uint word, uint signs, uint bit0) {
    vec4 v = unpack_i8(word);
    return v * vec4((signs & (1u << (bit0 + 0u))) != 0u ? -1.0 : 1.0,
                    (signs & (1u << (bit0 + 1u))) != 0u ? -1.0 : 1.0,
                    (signs & (1u << (bit0 + 2u))) != 0u ? -1.0 : 1.0,
                    (signs & (1u << (bit0 + 3u))) != 0u ? -1.0 : 1.0);
}

int signed_bytes(uint word, uint signs) {
#ifdef Q36_SIGN_LUT
    uvec2 mask = sign_lut[signs & 15u];
    return int((word ^ mask.x) + mask.y);
#else
    uint bits = ((signs & 15u) * 0x00204081u) & 0x01010101u;
    return int((word ^ (bits * 255u)) + bits);
#endif
}

/* Byte products sum exactly before the original per-grid float scales. */
float grid_dot(uint word, uint signs, uint bit0, int q) {
#if Q36_TOKENS > 1 || defined(Q36_INT_DOT)
    return float(dotPacked4x8EXT(signed_bytes(word, signs >> bit0), q));
#else
    return dot(unpack_i8(uint(signed_bytes(word, signs >> bit0))), unpack_i8(uint(q)));
#endif
}

float iq4_value(uint q) {
    const int values[16] = int[16](
        -127, -104, -83, -65, -49, -35, -22, -10,
           1,   13,  25,  38,  53,  69,  89, 113);
    return float(values[q]);
}

vec4 dequant_word(uint row, uint qb, uint word) {
    uint idx = word * 4u;
    uint group = idx >> 5u;
    uint l = (idx & 31u) >> 3u;
    uint part = (idx >> 2u) & 1u;
    uint base = row * pc.row_bytes;
    float d;

    if (QTYPE == IQ2_XXS) {
        base += qb * 66u;
        uint packed = load_u32(base + 6u + 8u * group);
        uint entry = load_u8(base + 2u + 8u * group + l);
        uint signs = table_u8(TAB_KSIGNS_BYTES + ((packed >> (7u * l)) & 127u));
        d = unpackHalf2x16(load_u16(base)).x *
            (0.5 + float(packed >> 28u)) * 0.25;
        return d * signed_grid(tables[TAB_IQ2XXS + entry * 2u + part], signs, part * 4u);
    }
    if (QTYPE == IQ2_XS) {
        base += qb * 74u;
        uint qs = load_u16(base + 2u + 8u * group + 2u * l);
        uint sc = load_u8(base + 66u + group);
        uint nibble = l < 2u ? sc & 15u : sc >> 4u;
        uint signs = table_u8(TAB_KSIGNS_BYTES + (qs >> 9u));
        d = unpackHalf2x16(load_u16(base)).x *
            (0.5 + float(nibble)) * 0.25;
        return d * signed_grid(tables[TAB_IQ2XS + (qs & 511u) * 2u + part],
                               signs, part * 4u);
    }
    if (QTYPE == IQ2_S) {
        base += qb * 82u;
        uint qh = load_u8(base + 66u + group);
        uint entry = load_u8(base + 2u + 4u * group + l) |
                     ((qh << (8u - 2u * l)) & 0x300u);
        uint signs = load_u8(base + 34u + 4u * group + l);
        uint sc = load_u8(base + 74u + group);
        uint nibble = l < 2u ? sc & 15u : sc >> 4u;
        d = unpackHalf2x16(load_u16(base)).x *
            (0.5 + float(nibble)) * 0.25;
        return d * signed_grid(tables[TAB_IQ2S + entry * 2u + part], signs, part * 4u);
    }
    if (QTYPE == IQ1_S) {
        base += qb * 50u;
        uint qh = load_u16(base + 34u + 2u * group);
        uint entry = load_u8(base + 2u + 4u * group + l) |
                     (((qh >> (3u * l)) & 7u) << 8u);
        float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
        d = unpackHalf2x16(load_u16(base)).x *
            float(2u * ((qh >> 12u) & 7u) + 1u);
        return d * (unpack_i8(tables[TAB_IQ1S + entry * 2u + part]) + delta);
    }

    uint sub = idx >> 5u;
    uint in_sub = idx & 31u;
    base += (qb * 8u + sub) * 18u;
    uint j = in_sub & 15u;
    uint packed = load_u32(base + 2u + (j & 12u));
    uint shift = 8u * (j & 3u) + (in_sub >= 16u ? 4u : 0u);
    vec4 v;
    if ((j & 3u) == 0u) {
        v = vec4(iq4_value((packed >> (shift + 0u)) & 15u),
                 iq4_value((packed >> (shift + 8u)) & 15u),
                 iq4_value((packed >> (shift + 16u)) & 15u),
                 iq4_value((packed >> (shift + 24u)) & 15u));
    } else {
        v = vec4(0.0);
    }
    d = unpackHalf2x16(load_u16(base)).x;
    return d * v;
}

float block_dot(uint row, uint qb, uint group, int qv[8]) {
    uint base = row * pc.row_bytes;
    float sum = 0.0;
    float d;
    if (QTYPE == IQ2_XXS) {
        base += qb * 66u;
        uint packed = load_u32(base + 6u + 8u * group);
        d = unpackHalf2x16(load_u16(base)).x *
            (0.5 + float(packed >> 28u)) * 0.25;
        UNROLL for (uint l = 0u; l < 4u; l++) {
            uint entry = load_u8(base + 2u + 8u * group + l);
            uint signs = table_u8(TAB_KSIGNS_BYTES + ((packed >> (7u * l)) & 127u));
            sum += grid_dot(tables[TAB_IQ2XXS + entry * 2u], signs, 0u, qv[2u * l]);
            sum += grid_dot(tables[TAB_IQ2XXS + entry * 2u + 1u], signs, 4u, qv[2u * l + 1u]);
        }
        return d * sum;
    }
    if (QTYPE == IQ2_XS) {
        base += qb * 74u;
        float wd = unpackHalf2x16(load_u16(base)).x * 0.25;
        uint sc = load_u8(base + 66u + group);
        UNROLL for (uint l = 0u; l < 4u; l++) {
            uint qs = load_u16(base + 2u + 8u * group + 2u * l);
            uint signs = table_u8(TAB_KSIGNS_BYTES + (qs >> 9u));
            d = wd * (0.5 + float(l < 2u ? sc & 15u : sc >> 4u));
            sum += d * grid_dot(tables[TAB_IQ2XS + (qs & 511u) * 2u], signs, 0u, qv[2u * l]);
            sum += d * grid_dot(tables[TAB_IQ2XS + (qs & 511u) * 2u + 1u], signs, 4u, qv[2u * l + 1u]);
        }
        return sum;
    }
    if (QTYPE == IQ2_S) {
        base += qb * 82u;
        float wd = unpackHalf2x16(load_u16(base)).x * 0.25;
        uint qh = load_u8(base + 66u + group);
        uint sc = load_u8(base + 74u + group);
        UNROLL for (uint l = 0u; l < 4u; l++) {
            uint entry = load_u8(base + 2u + 4u * group + l) |
                         ((qh << (8u - 2u * l)) & 0x300u);
            uint signs = load_u8(base + 34u + 4u * group + l);
            d = wd * (0.5 + float(l < 2u ? sc & 15u : sc >> 4u));
            sum += d * grid_dot(tables[TAB_IQ2S + entry * 2u], signs, 0u, qv[2u * l]);
            sum += d * grid_dot(tables[TAB_IQ2S + entry * 2u + 1u], signs, 4u, qv[2u * l + 1u]);
        }
        return sum;
    }
    if (QTYPE == IQ1_S) {
        base += qb * 50u;
        uint qh = load_u16(base + 34u + 2u * group);
        d = unpackHalf2x16(load_u16(base)).x *
            float(2u * ((qh >> 12u) & 7u) + 1u);
        float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
        UNROLL for (uint l = 0u; l < 4u; l++) {
            uint entry = load_u8(base + 2u + 4u * group + l) |
                         (((qh >> (3u * l)) & 7u) << 8u);
            sum += dot(unpack_i8(tables[TAB_IQ1S + entry * 2u]) + delta, unpack_i8(uint(qv[2u * l])));
            sum += dot(unpack_i8(tables[TAB_IQ1S + entry * 2u + 1u]) + delta, unpack_i8(uint(qv[2u * l + 1u])));
        }
        return d * sum;
    }

    base += (qb * 8u + group) * 18u;
    d = unpackHalf2x16(load_u16(base)).x;
    UNROLL for (uint i = 0u; i < 8u; i++) {
        uint packed = load_u32(base + 2u + 4u * (i & 3u));
        uint shift = i >= 4u ? 4u : 0u;
        vec4 v = vec4(iq4_value((packed >> (shift + 0u)) & 15u),
                      iq4_value((packed >> (shift + 8u)) & 15u),
                      iq4_value((packed >> (shift + 16u)) & 15u),
                      iq4_value((packed >> (shift + 24u)) & 15u));
        sum += dot(v, unpack_i8(uint(qv[i])));
    }
    return d * sum;
}

#if Q36_TOKENS > 1 && !defined(Q36_TYPE)
/* IQ1_S grids are -1, 0, 1 plus a shared +/-1/8 offset. Both terms
 * sum exactly in f32; the existing Q8 block sums supply the offset term.
 * Reuse each grid across tokens, then apply the decode scales in order. */
void iq1_verify(void) {
    uint lid = gl_LocalInvocationID.x, group = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;
    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
            if (row >= pc.out_dim) continue;
            uint base = row * pc.row_bytes + b * 50u;
            uint high = load_u16(base + 34u + 2u * group);
            float d = unpackHalf2x16(load_u16(base)).x * float(2u * ((high >> 12u) & 7u) + 1u);
            float delta = (high & 0x8000u) != 0u ? -0.125 : 0.125;
            int sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0;
            UNROLL for (uint l = 0u; l < 4u; l++) {
                uint entry = load_u8(base + 2u + 4u * group + l) | (((high >> (3u * l)) & 7u) << 8u);
                int w0 = int(tables[TAB_IQ1S + 2u * entry]);
                int w1 = int(tables[TAB_IQ1S + 2u * entry + 1u]);
                UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                    uint qbase = (t * pc.blocks + b) * Q8K_WORDS + 2u + 8u * group + 2u * l;
                    sum[t] += dotPacked4x8EXT(w0, int(input_word(qbase)));
                    sum[t] += dotPacked4x8EXT(w1, int(input_word(qbase + 1u)));
                }
            }
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                uint qb = (t * pc.blocks + b) * Q8K_WORDS;
                uint bs = input_word(qb + 66u + group);
                int qsum = bitfieldExtract(int(bs), 0, 16) + bitfieldExtract(int(bs), 16, 16);
                float value = d * (float(sum[t]) + delta * float(qsum));
                acc[t][r] = fma(uintBitsToFloat(input_word(qb)), value, acc[t][r]);
            }
        }
    }
    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            if (lid == 0u && first_row + r < pc.out_dim)
                store_output(t,first_row+r,total * pc.scale);
        }
    }
}
#endif

#if Q36_TOKENS > 1 && defined(Q36_TYPE) && (Q36_TYPE == 17 || Q36_TYPE == 22)
/* Decode each weight group once, but keep every token's scaled sum local
 * so the compiler retains the ordinary decode contraction order. */
void main(void) {
    Q36_INIT_ROUTE
    init_signs();
    uint lid=gl_LocalInvocationID.x,group=lid&7u;
    uint first=gl_WorkGroupID.x*ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for(uint t=0u;t<N_TOKENS;t++)
        UNROLL for(uint r=0u;r<ROWS;r++)acc[t][r]=0.0;
    for(uint b=lid>>3u;b<pc.blocks;b+=8u) {
        UNROLL for(uint r=0u;r<ROWS;r++) {
            uint row=first+r;
            uint base=row*pc.row_bytes+b*(QTYPE==IQ2_S?82u:74u);
            float wd=unpackHalf2x16(load_u16(base)).x*0.25;
            uint scales=load_u8(base+(QTYPE==IQ2_S?74u:66u)+group);
            uint high=QTYPE==IQ2_S?load_u8(base+66u+group):0u;
            ivec2 weights[4];float d[4];
            UNROLL for(uint l=0u;l<4u;l++) {
                uint entry,signs;
                if(QTYPE==IQ2_S) {
                    entry=load_u8(base+2u+4u*group+l)|((high<<(8u-2u*l))&0x300u);
                    signs=load_u8(base+34u+4u*group+l);
                } else {
                    uint qs=load_u16(base+2u+8u*group+2u*l);
                    entry=qs&511u;
                    uint bits=qs>>9u;
                    signs=bits|((bitCount(bits)&1u)<<7u);
                }
                uint tab=(QTYPE==IQ2_S?TAB_IQ2S:TAB_IQ2XS)+2u*entry;
                weights[l]=ivec2(signed_bytes(tables[tab],signs),signed_bytes(tables[tab+1u],signs>>4u));
                d[l]=wd*(0.5+float(l<2u?scales&15u:scales>>4u));
            }
            UNROLL for(uint t=0u;t<N_TOKENS;t++) {
                uint qbase=(t*pc.blocks+b)*Q8K_WORDS+2u+8u*group;
                float sum=0.0;
                UNROLL for(uint l=0u;l<4u;l++) {
                    sum+=d[l]*float(dotPacked4x8EXT(weights[l].x,int(input_word(qbase+2u*l))));
                    sum+=d[l]*float(dotPacked4x8EXT(weights[l].y,int(input_word(qbase+2u*l+1u))));
                }
                float yd=uintBitsToFloat(input_word((t*pc.blocks+b)*Q8K_WORDS));
                acc[t][r]=fma(yd,sum,acc[t][r]);
            }
        }
    }
    UNROLL for(uint t=0u;t<N_TOKENS;t++) {
        UNROLL for(uint r=0u;r<ROWS;r++) {
            float value=subgroupAdd(acc[t][r]);
            if(lid==0u)store_output(t,first+r,value*pc.scale);
        }
    }
}
#elif Q36_TOKENS > 1 && defined(Q36_TYPE) && Q36_TYPE == 16

void main(void) {
    Q36_INIT_ROUTE
    init_signs();
    uint lid = gl_LocalInvocationID.x, group = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;
    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
            if (row >= pc.out_dim) continue;
            uint base = row * pc.row_bytes + b * 66u;
            uint scales = load_u32(base + 6u + 8u * group);
            /* The 32 byte products sum exactly before applying the block scale. */
            int sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0;
            UNROLL for (uint l = 0u; l < 4u; l++) {
                uint entry = load_u8(base + 2u + 8u * group + l);
                uint sign_bits = (scales >> (7u * l)) & 127u;
                uint signs = sign_bits | ((bitCount(sign_bits) & 1u) << 7u);
                uint table = TAB_IQ2XXS;
                int w0 = signed_bytes(tables[table + 2u * entry], signs);
                int w1 = signed_bytes(tables[table + 2u * entry + 1u], signs >> 4u);
                UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                    uint qbase = (t * pc.blocks + b) * Q8K_WORDS + 2u + 8u * group + 2u * l;
                    sum[t] += dotPacked4x8EXT(w0, int(input_word(qbase)));
                    sum[t] += dotPacked4x8EXT(w1, int(input_word(qbase + 1u)));
                }
            }
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                float yd = uintBitsToFloat(input_word((t * pc.blocks + b) * Q8K_WORDS));
                float v = float(sum[t]);
                v *= unpackHalf2x16(load_u16(base)).x * (0.5 + float(scales >> 28u)) * 0.25;
                acc[t][r] = fma(yd, v, acc[t][r]);
            }
        }
    }
    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u && row < pc.out_dim) store_output(t,row,total * pc.scale);
        }
    }
}

#else
void main(void) {
    Q36_INIT_ROUTE
#if Q36_TOKENS > 1 && !defined(Q36_TYPE)
    if (QTYPE == IQ1_S) {
        iq1_verify();
        return;
    }
#endif
#ifdef Q36_SIGN_LUT
    init_signs();
#endif
    uint lid = gl_LocalInvocationID.x;
    uint lane8 = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;

    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
            uint token_offset = t * pc.blocks * Q8K_WORDS;
            uint qbase = b * Q8K_WORDS + 2u + 8u * lane8;
            float yd = uintBitsToFloat(input_word(token_offset + b * Q8K_WORDS));
            int qv[8];
            UNROLL for (uint i = 0u; i < 8u; i++) qv[i] = int(input_word(token_offset + qbase + i));
            UNROLL for (uint r = 0u; r < ROWS; r++) {
                uint row = first_row + r;
                if (row >= pc.out_dim) continue;
                float sum = block_dot(row, b, lane8, qv);
                acc[t][r] = fma(yd, sum, acc[t][r]);
            }
        }
    }

    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u && row < pc.out_dim) store_output(t,row,total * pc.scale);
        }
    }
}
#endif
