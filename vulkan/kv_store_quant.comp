#version 460

/* Quantized KV store: one workgroup (256 threads) per token.
 * Blocks processed sequentially. Staging buffer with atomicOr writes,
 * then copy to cache as aligned uints. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Cache {
    uint cache[];
};

layout(set = 0, binding = 1) readonly buffer Src {
    float src[];
};

layout(push_constant) uniform Push {
    uint row_elems;
    uint cache_row_bytes;
    uint pos0;
    uint n_tok;
    uint qtype;   /* 1 = Q8_0, 2 = Q4_0 */
} pc;

const uint QK = 32u;

/* All shared vars at global scope */
shared float sh_blk[32];   /* one block of source values */
shared float sh_extreme;   /* reduction result for current block */
shared uint  sh_row[144];  /* staging: up to 576 bytes */

int nearest_int(float f) {
    precise float g = f + 12582912.0;  /* keep the fma contractor away */
    return int(floatBitsToUint(g) & 0x007fffffu) - 0x00400000;
}

/* f32 -> f16 round-to-nearest-even, bit-matching q36_quant_f32_to_f16().
 * packHalf2x16 rounds toward zero on AMD and cannot be used for scales. */
uint f16_rte(float f) {
    uint w = floatBitsToUint(f);
    uint shl1 = w + w;
    uint sign = w & 0x80000000u;
    uint bias = shl1 & 0xff000000u;
    if (bias < 0x71000000u) bias = 0x71000000u;
    precise float base = abs(f) * uintBitsToFloat(0x77800000u);  /* 0x1.0p+112 */
    base *= uintBitsToFloat(0x08800000u);                        /* 0x1.0p-110 */
    base += uintBitsToFloat((bias >> 1) + 0x07800000u);
    uint bits = floatBitsToUint(base);
    uint nonsign = ((bits >> 13) & 0x7c00u) + (bits & 0xfffu);
    return (sign >> 16) | (shl1 > 0xff000000u ? 0x7e00u : nonsign);
}

void main(void) {
    uint lid  = gl_LocalInvocationID.x;
    uint tok  = gl_WorkGroupID.y;
    uint pos  = pc.pos0 + tok;
    uint src_base = tok * pc.row_elems;
    uint n_blocks = pc.row_elems / QK;
    uint blk_bytes = (pc.qtype == 1u) ? 34u : 18u;
    uint n_stage = (n_blocks * blk_bytes + 3u) / 4u;

    /* Zero staging buffer */
    for (uint i = lid; i < n_stage; i += 256u) sh_row[i] = 0u;
    barrier();

    for (uint blk = 0u; blk < n_blocks; blk++) {
        /* Load block values into shared */
        if (lid < QK) sh_blk[lid] = src[src_base + blk * QK + lid];
        barrier();

        /* Lane 0: sequential reduction */
        if (lid == 0u) {
            float ext = 0.0;
            if (pc.qtype == 1u) {
                for (uint i = 0u; i < QK; i++) ext = max(ext, abs(sh_blk[i]));
            } else {
                float amax = 0.0;
                for (uint i = 0u; i < QK; i++) {
                    float a = abs(sh_blk[i]);
                    if (a > amax) { amax = a; ext = sh_blk[i]; }
                }
            }
            sh_extreme = ext;
        }
        barrier();

        float extreme = sh_extreme;
        /* fp64 divide: f32 division is 2.5 ulp on RADV, the host is exact */
        float d = (pc.qtype == 1u) ? float(double(extreme) / 127.0)
                                   : extreme / (-8.0);
        /* fp64 divide: f32 rcp is 2.5 ulp on RADV, the host divide is exact */
        float id = d != 0.0 ? float(double(1.0) / double(d)) : 0.0;

        /* Nudge the KV scale toward its least-squares fit without changing
         * the Q4_0 block layout. */
        if (pc.qtype == 2u) {
            if (lid == 0u) {
                double num = 0.0;
                int den = 0;
                for (uint i = 0u; i < QK; i++) {
                    precise float p = sh_blk[i] * id + 8.5;
                    int q = clamp(int(p), 0, 15) - 8;
                    num += double(sh_blk[i]) * double(q);
                    den += q * q;
                }
                if (den != 0) {
                    float fit = float(num / double(den));
                    precise float refined = d + (fit - d) * 0.25;
                    sh_extreme = refined;
                } else {
                    sh_extreme = d;
                }
            }
            barrier();
            d = sh_extreme;
            if (extreme == 0.0) d = uintBitsToFloat(0x80000000u);
            id = d != 0.0 ? float(double(1.0) / double(d)) : 0.0;
        }

        uint blk_off = blk * blk_bytes;
        uint scale_u = f16_rte(d);

        /* Write scale (2 bytes) via atomicOr into staging */
        if (lid == 0u) {
            uint w0 = blk_off / 4u;
            uint s0 = (blk_off & 3u) * 8u;
            atomicOr(sh_row[w0], (scale_u & 0xFFFFu) << s0);
            if (s0 > 0u)
                atomicOr(sh_row[w0 + 1u], (scale_u & 0xFFFFu) >> (32u - s0));
        }

        /* Write quantized values */
        if (pc.qtype == 1u) {
            /* Q8_0: 32 int8 values */
            if (lid < QK) {
                precise float p = sh_blk[lid] * id;
                int q = id != 0.0 ? nearest_int(p) : 0;
                q = clamp(q, -128, 127);
                uint byte_off = blk_off + 2u + lid;
                uint w = byte_off / 4u;
                uint s = (byte_off & 3u) * 8u;
                atomicOr(sh_row[w], (uint(q) & 0xFFu) << s);
            }
        } else {
            /* Q4_0: 16 packed nibble pairs */
            if (lid < 16u) {
                precise float p0 = sh_blk[lid] * id + 8.5;
                precise float p1 = sh_blk[lid + 16u] * id + 8.5;
                int q0 = clamp(int(p0), 0, 15);
                int q1 = clamp(int(p1), 0, 15);
                uint packed = (uint(q0) & 0xFu) | ((uint(q1) & 0xFu) << 4u);
                uint byte_off = blk_off + 2u + lid;
                uint w = byte_off / 4u;
                uint s = (byte_off & 3u) * 8u;
                atomicOr(sh_row[w], packed << s);
            }
        }
        barrier();
    }

    /* Copy staging to cache */
    uint cache_base = (pos * pc.cache_row_bytes) / 4u;
    for (uint i = lid; i < n_stage; i += 256u)
        cache[cache_base + i] = sh_row[i];
}
