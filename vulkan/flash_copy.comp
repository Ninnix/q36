#version 460
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Input { uint x[]; };
layout(binding = 1) writeonly buffer Output { uint y[]; };
layout(push_constant) uniform Push { uint words, in_stride, out_stride; } p;
void main() {
    uint i=gl_GlobalInvocationID.x, row=gl_WorkGroupID.y;
    if (i<p.words) y[row*p.out_stride+i]=x[row*p.in_stride+i];
}
