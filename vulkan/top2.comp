#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input { float x[]; };

struct Pair {
    float v0;
    float v1;
    int i0;
    int i1;
};

layout(set = 0, binding = 1) buffer Partials { Pair part[]; };
layout(set = 0, binding = 2) writeonly buffer Output { int ids[]; };

layout(push_constant) uniform Push {
    uint count;
    uint groups;
    uint pass;
} pc;

shared float values0[256];
shared float values1[256];
shared int indices0[256];
shared int indices1[256];

bool better(float v, int i, float best_v, int best_i) {
    return i >= 0 && (best_i < 0 || v > best_v ||
                      (v == best_v && i < best_i));
}

void insert_pair(inout float v0, inout int i0,
                 inout float v1, inout int i1,
                 float v, int i) {
    if (i < 0 || i == i0 || i == i1) return;
    if (better(v, i, v0, i0)) {
        v1 = v0;
        i1 = i0;
        v0 = v;
        i0 = i;
    } else if (better(v, i, v1, i1)) {
        v1 = v;
        i1 = i;
    }
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    float v0 = uintBitsToFloat(0xff800000u);
    float v1 = v0;
    int i0 = -1;
    int i1 = -1;

    if (pc.pass == 0u) {
        uint i = gl_WorkGroupID.x * 256u + lid;
        uint step = pc.groups * 256u;
        for (; i < pc.count; i += step)
            insert_pair(v0, i0, v1, i1, x[i], int(i));
    } else if (lid < pc.groups) {
        Pair p = part[lid];
        insert_pair(v0, i0, v1, i1, p.v0, p.i0);
        insert_pair(v0, i0, v1, i1, p.v1, p.i1);
    }

    values0[lid] = v0;
    values1[lid] = v1;
    indices0[lid] = i0;
    indices1[lid] = i1;
    barrier();

    for (uint step = 128u; step != 0u; step >>= 1u) {
        if (lid < step) {
            insert_pair(values0[lid], indices0[lid],
                        values1[lid], indices1[lid],
                        values0[lid + step], indices0[lid + step]);
            insert_pair(values0[lid], indices0[lid],
                        values1[lid], indices1[lid],
                        values1[lid + step], indices1[lid + step]);
        }
        barrier();
    }

    if (lid != 0u) return;
    if (pc.pass == 0u) {
        uint group = gl_WorkGroupID.x;
        part[group].v0 = values0[0];
        part[group].v1 = values1[0];
        part[group].i0 = indices0[0];
        part[group].i1 = indices1[0];
    } else {
        ids[0] = indices0[0];
        ids[1] = indices1[0];
    }
}
