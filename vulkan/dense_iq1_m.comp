#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    float scale;
} pc;

const uint Q8K_WORDS = 74u;
const uint TAB_IQ1S_GRID = 3360u;

uint load_u8(uint off) {
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
}

uint load_u16(uint off) {
    return uint(wh[off >> 1u]);
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

void main(void) {
    uint lane = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;
    if (row >= pc.out_dim || tok >= pc.n_tok) return;
    float acc = 0.0;
    for (uint b = 0u; b < pc.blocks; b++) {
        uint wbase = row * pc.row_bytes + b * 56u;
        uint qbase = (tok * pc.blocks + b) * Q8K_WORDS;
        uint ib = lane >> 2u;
        uint l = lane & 3u;
        uint qh = load_u8(wbase + 32u + lane / 2u);
        uint hi = (l & 1u) != 0u ? qh << 4u : qh << 8u;
        uint entry = load_u8(wbase + lane) | (hi & 0x700u);
        vec4 w0 = unpack_i8(tables[TAB_IQ1S_GRID + entry * 2u]);
        vec4 w1 = unpack_i8(tables[TAB_IQ1S_GRID + entry * 2u + 1u]);
        vec4 q0 = unpack_i8(q8[qbase + 2u + lane * 2u]);
        vec4 q1 = unpack_i8(q8[qbase + 3u + lane * 2u]);
        float delta = (qh & ((l & 1u) != 0u ? 0x80u : 0x08u)) != 0u ? -0.125 : 0.125;
        float sum = dot(q0, w0 + delta) + dot(q1, w1 + delta);
        uint sc0 = load_u16(wbase + 48u);
        uint sc1 = load_u16(wbase + 50u);
        uint sc2 = load_u16(wbase + 52u);
        uint sc3 = load_u16(wbase + 54u);
        uint dh = (sc0 >> 12u) | ((sc1 >> 8u) & 0x00f0u) |
                  ((sc2 >> 4u) & 0x0f00u) | (sc3 & 0xf000u);
        uint sc = load_u16(wbase + 48u + 2u * (ib / 2u));
        uint shift = 6u * (ib & 1u) + 3u * (l >> 1u);
        float wd = unpackHalf2x16(dh).x * float(2u * ((sc >> shift) & 7u) + 1u);
        float yd = uintBitsToFloat(q8[qbase]);
        acc = fma(wd * yd, sum, acc);
    }
    float total = subgroupAdd(acc);
    if (lane == 0u) y[tok * pc.out_dim + row] = total * pc.scale;
}
