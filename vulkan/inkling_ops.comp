        float sc=p.k!=0 ? d[od+id] : 1, gate=b[ob+base]*sc, up=b[ob+base+p.n]*sc;
        precise float act=(4*ink_tanh(gate*0.25))*sig(gate);
        precise float value=act*(25*ink_tanh(up*0.04));
        if (p.m!=0) pack_q8(((oa+i)/32)*9,l,value,true); else a[oa+i]=value;
    } else if (OP==12 && i<p.n) {
        precise float v=(e[oa+i]-ink_tanh(d[od+i])*e[oa+i])+ink_tanh(c[oc+i])*b[(token*4+p.j)*width+i];
        a[oa+i]=v;
    } else if (OP==13 && i<p.n) a[oa+i]=30*ink_tanh(a[oa+i]*(1.0/30.0));
    else if (OP==14) {
#ifdef INK_FMA
        if (gl_SubgroupSize==32) {
            // Merge the four subgroup top eights. Equal scores keep expert ID order.
            float prob=sig(b[ob+l]), score=prob+c[oc+l];
            uint lane=gl_SubgroupInvocationID, id=l;
            lanes[l]=prob;
            [[unroll]] for (uint width=2;width<=32;width*=2) route_merge(score,id,width,lane);
            if (lane<8) {
                uint at=gl_SubgroupID*8+(gl_SubgroupID%2==0 ? lane : 7-lane);
                route_score[at]=score;
                route_id[at]=id;
            }
            barrier();
            if (gl_SubgroupID==0) {
                score=route_score[lane]; id=route_id[lane];
                route_merge(score,id,16,lane);
                route_merge(score,id,32,lane);
                prob=lanes[id];
                double sum=0;
                [[unroll]] for (uint j=0;j<8;j++) sum+=double(subgroupShuffle(prob,j));
                if (lane<8) {
                    precise float den=q36_router_round(sum)+1e-20;
                    a[oa+lane]=uintBitsToFloat(id);
                    a[oa+8+lane]=q36_router_round(double(prob)/double(den))*8;
                }
            }
            return;
        }
#endif
        float prob=sig(b[ob+l]), score=prob+c[oc+l];
        lanes[l]=score; barrier();
        uint rank=0;
        for (uint j=0;j<128;j++) rank+=uint(lanes[j]>score || (lanes[j]==score && j<l));
        if (rank<8) { probabilities[rank]=prob; selected[rank]=l; }
        barrier();
        if (l<8) {
            double sum=0;
            for (uint j=0;j<8;j++) sum+=probabilities[j];
            a[oa+l]=uintBitsToFloat(selected[l]);
            precise float den=q36_router_round(sum)+1e-20;
            a[oa+8+l]=q36_router_round(double(probabilities[l])/double(den))*8;
        }
    } else if (OP==15 && i<p.n) {
        a[oa+token*p.k+p.m+i]=b[ob+token*p.j+p.t+i];
    } else if (OP==16) {
        uint block=g*4+l/32, base=token*p.n;
        // All Inkling projection widths are multiples of 64. Pad the final
        // half-group in shared memory and suppress writes past the row.
        float v=block<p.n/32 ? b[base+block*32+l%32] : 0;
        pack_q8((base/32+block)*9,l,v,block<p.n/32);
    } else if (OP==17) {
        uint base=16*p.u;
        starts[l]=0; barrier();
        for (uint i=l;i<8*p.u;i+=128) atomicAdd(starts[floatBitsToUint(a[(i/8)*16+i%8])],1);
        barrier();
        uint count=starts[l], groups=(count+7)/8;
        starts[l]=groups; barrier();
        for (uint step=1;step<128;step*=2) {
            uint v=l>=step ? starts[l-step] : 0; barrier();
            starts[l]+=v; barrier();
        }
        uint end=starts[l], first=end-groups;
        if (l==127) a[base]=uintBitsToFloat(end);
        // Pair adjacent tiles when at least thirteen routes share the weights.
        for (uint g=first;g<end;g++) {
            uint index=g-first, pair=index/2<(count+3)/16 ? (index%2==0 ? 128 : 256) : 0;
            a[base+1+9*g]=uintBitsToFloat(l|pair);
        }
        if (count%8!=0) for (uint i=count%8;i<8;i++) a[base+2+9*(end-1)+i]=uintBitsToFloat(~0u);
        starts[l]=first*8; barrier();
        for (uint i=l;i<8*p.u;i+=128) {
            uint expert=floatBitsToUint(a[(i/8)*16+i%8]);
            uint slot=atomicAdd(starts[expert],1);
            a[base+2+9*(slot/8)+slot%8]=uintBitsToFloat(i);
        }
    } else if (OP==18) {
        uint msg=(token*4+g)*width;
        uint state=token*width;
        if (l<64) {
            uint src=l/32;
            float dot=0;
            for (uint start=l%32;start<width;start+=256)
                [[unroll]] for (uint k=0;k<8;k++) {
                    uint j=start+k*32;
                    dot=ink_fma(src==0 ? b[state+j] : d[state+j],e[g*width+j],dot);
                }
            lanes[l]=dot;
        }
        barrier();
        if (l<2) {
            precise float q[8]; uint z=32*l;
            for (uint j=0;j<8;j++) q[j]=(lanes[z+j]+lanes[z+j+16])+(lanes[z+j+8]+lanes[z+j+24]);
            for (uint j=0;j<4;j++) q[j]+=q[j+4];
            weight[l]=((q[0]+q[1])+(q[2]+q[3]))*uintBitsToFloat(p.j);
        }
        barrier();
        if (l==0) {
            float top=max(weight[0],weight[1]), lo=q36_router_exp(weight[0]-top), hi=q36_router_exp(weight[1]-top);
            float inv=q36_router_round(1.0LF/(double(lo)+double(hi)));
            weight[0]=lo*inv; weight[1]=hi*inv;
        }
        barrier();
        double ss=0;
        for (uint j=l;j<width;j+=128) {
            precise float x=weight[0]*b[state+j]+weight[1]*d[state+j];
            a[msg+j]=x; ss+=square(x);
        }
        float inv=inv_norm(total(ss,l),width);
        if (l==0) c[p.m!=0 ? (g/4)*64+g%4 : 4*token+g]=inv;
    } else if ((OP==19 || OP==27) && i<width) {
        uint off=(i/64)*4096+i%64, src=token*64;
        float gain[8], forget[8];
        [[unroll]] for (uint j=0;j<8;j++) {
            float v[4], f[4];
            [[unroll]] for (uint k=0;k<4;k++) {
                uint col=j+8*k, at=off+col*64;
                float g0,f0,g1,f1;
                if (OP==27) {
                    uint off=(i/64)*2048+col*64+i%64;
                    uint gain=floatBitsToUint(c[off]), forget=floatBitsToUint(d[off]);
                    g0=uintBitsToFloat(gain<<16); g1=uintBitsToFloat(gain&0xffff0000u);
                    f0=uintBitsToFloat(forget<<16); f1=uintBitsToFloat(forget&0xffff0000u);
                } else {
                    g0=c[at]; g1=c[at+2048]; f0=d[at]; f1=d[at+2048];
                }
                precise float a=g0*b[src+col], z=f0*b[src+col];
                v[k]=ink_fma(g1,b[src+col+32],a);
                f[k]=ink_fma(f1,b[src+col+32],z);
            }
            precise float gv=(v[0]+v[2])+(v[1]+v[3]), fv=(f[0]+f[2])+(f[1]+f[3]);
            gain[j]=gv; forget[j]=fv;
        }
        [[unroll]] for (uint j=0;j<4;j++) { gain[j]+=gain[j+4]; forget[j]+=forget[j+4]; }
        precise float v=(gain[0]+gain[1])+(gain[2]+gain[3]), forget_gate=(forget[0]+forget[1])+(forget[2]+forget[3]);
        uint dst=token*width+i;
        precise float outv=(f[dst]-ink_tanh(forget_gate)*f[dst])+ink_tanh(v)*e[(token*4+p.j)*width+i];
        a[dst]=outv;
    } else if (OP==28) {
        const uint count=width/gl_WorkGroupSize.x;
        float value[count]; double ss=0;
        [[unroll]] for (uint k=0;k<count;k++) {
            value[k]=b[g*p.k+k*gl_WorkGroupSize.x+l];
            ss+=square(value[k]);
        }
        float scale=inv_norm(total(ss,l),width);
        [[unroll]] for (uint k=0;k<count;k++) {
            uint ch=k*gl_WorkGroupSize.x+l, dst=g*p.j+ch;
            precise float x=value[k]*scale;
            if (p.m!=0) { a[dst]=x; a[dst+width]=c[g*width+ch]*d[g]; }
            else a[dst]=x*(g==0 ? c[ch] : g==1 ? d[ch] : e[ch]);
        }
    } else if (OP==20) {
        uint h=3*(p.j+i);
        float h0=p.m==0 ? 0 : e[h], h1=p.m==0 ? 0 : e[h+1], h2=p.m==0 ? 0 : e[h+2];
        float now=routed_output(0,i);
        precise float conv=h0*f[4*i]+h1*f[4*i+1]+h2*f[4*i+2]+now*f[4*i+3];
        a[i]+=(now+conv)*uintBitsToFloat(p.t);
        e[h]=h1; e[h+1]=h2; e[h+2]=now;
    } else if (OP==21 || OP==22 || OP==29) {
        bool value=OP==22 || (OP==29 && g>=8);
        uint ch=(g%8)*128+l, h=(p.k+(OP==29 ? i : ch))*3;
        float h0=p.n==0 ? 0 : c[h], h1=p.n==0 ? 0 : c[h+1], h2=p.n==0 ? 0 : c[h+2];
        float now=OP==29 && value ? f[ch] : b[ch];
        uint w=4*ch;
        vec4 taps=OP==29 && value ? vec4(e[w],e[w+1],e[w+2],e[w+3]) : vec4(d[w],d[w+1],d[w+2],d[w+3]);
        precise float conv=h0*taps.x+h1*taps.y+h2*taps.z+now*taps.w;
        if (OP!=29) {
            conv+=now*e[4*g]; conv+=h2*e[4*g+1]; conv+=h1*e[4*g+2]; conv+=h0*e[4*g+3];
        }
        c[h]=h1; c[h+1]=h2; c[h+2]=now;
        precise float val=(now+conv)*uintBitsToFloat(p.t);
        store_head(val,ch,value,p.n%p.j,l);
    } else if (OP==26 || OP==35) {
        uint tile=gl_WorkGroupID.z, base=16*p.u;
        if (p.j!=0 && tile>=floatBitsToUint(c[base])) return;
        uint desc=base+2+9*tile, step=p.k!=0 ? 8 : 1, stride=p.k!=0 ? 74 : 9;
        uint block=g/step, groups=p.n/(32*step), pair=l/32, j=l%8, k=(l/8)%4;
        uint at=(tile*groups+block)*(8+128*step+(p.k==2 ? 64 : 0));
        ivec2 val;
        for (uint side=0;side<2;side++) {
            uint id=p.j==0 ? min(8*tile+2*pair+side,p.u-1) : floatBitsToUint(c[desc+2*pair+side]);
            if (id==~0u) id=floatBitsToUint(c[desc]);
            uint src=((p.j==1 ? id/8 : id)*groups+block)*stride;
            int word=floatBitsToInt(b[src+(p.k!=0 ? 2 : 1)+8*(g%step)+j]);
            val[side]=bitfieldExtract(word,int(8*k),8);
            if (p.k==2 && l%32==0) a[at+1032+8*(g%step)+2*pair+side]=b[src+66+g%step];
            if (g%step==0 && l%32==0)
                a[at+2*pair+side]=p.k!=0 ? b[src] : unpackHalf2x16(floatBitsToUint(b[src])).x;
        }
        uint packed;
        if (OP==35) {
            uvec2 bits=uvec2(val)&65535u;
            packed=bits.x|(bits.y<<16);
        } else packed=packHalf2x16(vec2(val));
        a[at+8+128*(g%step)+l]=uintBitsToFloat(packed);
    }
}
