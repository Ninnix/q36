#ifndef INK_FMA
#define ink_fma q36_router_fma
#endif
layout(local_size_x=128,local_size_x_id=1) in;
layout(binding=0) buffer Output { float a[]; };
layout(binding=1) readonly buffer Input { float b[]; };
layout(binding=2) buffer State { float c[]; };
layout(binding=3) readonly buffer D { float d[]; };
#ifdef INK_FMA
layout(binding=3) readonly buffer KeyPair { uvec2 kv_pairs[]; };
#endif
layout(binding=4) buffer E { float e[]; };
layout(binding=5) readonly buffer F { float f[]; };
layout(push_constant) uniform Push { uint op,n,k,j,m,t,u,v; } p;
// Specialize the operation and both cache types when building the pipeline.
layout(constant_id=0) const uint MODE=0;
const uint code=MODE%64, KT=(MODE/64)%3, VT=(MODE/192)%3;
const bool key_interleaved=MODE>=64*9;
const bool tiled=code>=31 && code<=33;
const uint OP=code==31 ? 30 : code==32 ? 7 : code==33 ? 8 : code;
shared double sums[gl_WorkGroupSize.x];
shared vec4 mix_state[OP==1 || OP==23 ? 576 : 1], mix_query[OP==1 || OP==23 ? 576 : 1];
shared float lanes[OP==7 ? gl_WorkGroupSize.x : 128], weight[5];
const uint width=2304;
double total(double val, uint l) {
#ifdef INK_FMA
    for (uint step=gl_SubgroupSize/2;step!=0;step/=2)
        val+=packDouble2x32(subgroupShuffleXor(unpackDouble2x32(val),step));
    if (subgroupElect()) sums[gl_SubgroupID]=val;
    barrier();
    double sum=sums[0]+sums[1];
    for (uint i=2;i<gl_NumSubgroups;i+=2) sum+=sums[i]+sums[i+1];
    return sum;
#else
    sums[l]=val; barrier();
    for (uint j=gl_WorkGroupSize.x/2;j>0;j/=2) { if (l<j) sums[l]+=sums[l+j]; barrier(); }
    return sums[0];
#endif
}
// The FMA residual selects the nearest binary32 neighbor of the hardware
// estimate. Extreme operands use the existing double-precision path.
float ink_div(float a,float b) {
#ifdef INK_FMA
    if (a>=1e-12 && a<=1e12 && b>=1e-12 && b<=1e12) {
        float y=a/b;
        y=ink_fma(ink_fma(-y,b,a),1/b,y);
        float rem=ink_fma(-y,b,a);
        uint bits=floatBitsToUint(y);
        float next=uintBitsToFloat(rem<0 ? bits-1 : bits+1);
        float half_ulp=b*abs(next-y), residual=2*abs(rem);
        if (residual>half_ulp || (residual==half_ulp && (bits&1u)!=0)) y=next;
        return y;
    }
#endif
    return q36_router_round(double(a)/double(b));
}
float ink_sqrt(float x) {
#ifdef INK_FMA
    if (x>=1e-12 && x<=1e12) {
        float y=sqrt(x);
        y=ink_fma(0.5/y,ink_fma(-y,y,x),y);
        float rem=ink_fma(-y,y,x);
        uint bits=floatBitsToUint(y);
        float next=uintBitsToFloat(rem<0 ? bits-1 : bits+1);
        if (rem<0 ? -rem>=y*(y-next) : rem>y*(next-y)) y=next;
        return y;
    }
#endif
    return q36_router_round(sqrt(double(x)));
}
float clip_head(float x, double ss, float limit) {
    float scale=ink_div(1,max(ink_sqrt(q36_router_round(ss)),limit));
    precise float v=(x*scale)*limit;
    return v;
}
float inv_norm(double sum, uint n) {
    precise float mean=q36_router_round(sum/double(n))+1e-6;
    return ink_div(1,ink_sqrt(mean));
}
double square(float x) { precise float s=x*x; return double(s); }
float hsum8(float v[8]) {
    precise float r=((v[0]+v[4])+(v[2]+v[6]))+((v[1]+v[5])+(v[3]+v[7]));
    return r;
}
/* The [7/6] Pade approximant on [-0.625,0.625]. Carry its numerator
 * and denominator through four double-angle steps, then divide once. */
float ink_tanh_ref(float x) {
    if (abs(x)>=10) return sign(x);
    double v=double(x)*0.0625LF, z=v*v;
    double n=v*(1.0LF+z*(17325.0LF/135135.0LF+z*(378.0LF/135135.0LF+z/135135.0LF)));
    double d=1.0LF+z*(62370.0LF/135135.0LF+z*(3150.0LF/135135.0LF+z*(28.0LF/135135.0LF)));
    [[unroll]] for (int j=0;j<4;j++) { double a=2.0LF*n*d; d=d*d+n*n; n=a; }
    return float(n/d);
}
#ifdef INK_FMA
// Reduce around an integer, then use tanh(a+b). A double reciprocal
// refinement supplies the float result except immediately beside a midpoint.
float ink_tanh(float x) {
    if (!(abs(x)<10)) return isnan(x) ? x : sign(x);
    if (abs(x)<0.00006103515625) return x;
    const double center[11]=double[11](
        0.0LF, 0.76159415595576485LF, 0.9640275800758169LF,
        0.99505475368673046LF, 0.99932929973906703LF, 0.99990920426259511LF,
        0.99998771165079559LF, 0.99999833694394469LF, 0.99999977492967584LF,
        0.999999969540041LF, 0.99999999587769273LF);
    int k=int(abs(x)+0.5);
    double v=double(abs(x))-double(k), z=v*v, t=center[k];
    double n=v*(1.0LF+z*(17325.0LF/135135.0LF+z*(378.0LF/135135.0LF+z/135135.0LF)));
    double den=1.0LF+z*(62370.0LF/135135.0LF+z*(3150.0LF/135135.0LF+z*(28.0LF/135135.0LF)));
    double num=fma(t,den,n);
    den=fma(t,n,den);
    double inv=double(1.0/float(den));
    double val=(num*inv)*fma(-den,inv,2.0LF);
    uint tail=unpackDouble2x32(val).x&0x1fffffffu;
    if (abs(int(tail)-0x10000000)<2048) return ink_tanh_ref(x);
    return uintBitsToFloat(floatBitsToUint(float(val))|(floatBitsToUint(x)&0x80000000u));
}
#else
#define ink_tanh ink_tanh_ref
#endif
float sig(float x) { precise float den=1+q36_router_exp(-x); return ink_div(1,den); }
#ifdef INK_FMA
float ink_vector_exp(float x) {
    if (!(x>=-80 && x<=80)) return q36_router_exp(x);
    precise float z=fma(x,1.4426950216293335,12582912.0), n=z-12582912.0;
    precise float r=ink_fma(-n,1.428606765330187e-6,ink_fma(-n,0.693145751953125,x));
    float scale=uintBitsToFloat((floatBitsToUint(z)<<23)+0x3f800000u);
    precise float rr=r*r, tail=0.99999940395355225*r;
    float a=ink_fma(0.0082473903894424438,r,0.041899766772985458);
    float b=ink_fma(0.16668395698070526,r,0.49999126791954041);
    return ink_fma(ink_fma(ink_fma(a,rr,b),rr,tail),scale,scale);
}
#else
#define ink_vector_exp q36_router_vector_exp
#endif
// A page stores 32 rows. Keep packed scales in their own plane so each
// writer owns a complete word. Interleave V across time for the value sum.
uint data_words(uint type) { return 512u>>type; }
uint row_words(uint type) { return data_words(type)+(type==0 ? 0 : 16); }
uint cache_word(uint pos,bool value,bool scale,uint word) {
    uint base=(pos/32)*32*(row_words(KT)+row_words(VT));
    uint type=value ? VT : KT;
    if (value) base+=32*row_words(KT);
    if (scale) base+=32*data_words(type);
    // Put adjacent keys' words together for the paired decode loads.
    if (key_interleaved && !value) return base+32*word+pos%32;
    if (value) return base+(word/4)*128+(pos%32)*4+word%4;
    return base+(pos%32)*(scale ? 16 : data_words(type))+word;
}

shared float kv_inv[4];
shared uint kv_scale[4];
int quant4(float x,float inv) {
    precise float q=x*inv+8.5;
    return clamp(int(q),0,15);
}
void store_head(float x,uint ch,bool value,uint pos,uint l) {
    double ss=total(square(x),l);
    lanes[l]=value ? x*inv_norm(ss,128) : clip_head(x,ss,22.62741661);
    barrier();
    uint type=value ? VT : KT;
    if (type==0) {
        if (l%2==0) a[cache_word(pos,value,false,ch/2)]=
            uintBitsToFloat(q36_half(lanes[l])|(q36_half(lanes[l+1])<<16));
        return;
    }
    uint block=l/32;
    if (l%32==0) {
        float extreme=lanes[l];
        for (uint j=1;j<32;j++)
            if (abs(lanes[l+j])>abs(extreme)) extreme=lanes[l+j];
        float d=type==1 ? q36_div(abs(extreme),127) : extreme*(-0.125);
        float inv=d==0 ? 0 : q36_div(1,d);
        if (type==2) {
            // Match the CPU KV encoder's quarter-step least-squares scale fit.
            double num=0;
            int den=0;
            for (uint j=0;j<32;j++) {
                int q=quant4(lanes[l+j],inv)-8;
                num+=double(lanes[l+j])*double(q);
                den+=q*q;
            }
            if (den!=0) {
                precise float refined=d+(float(num/double(den))-d)*0.25;
                d=refined;
                inv=d==0 ? 0 : q36_div(1,d);
            }
        }
        kv_inv[block]=inv;
        kv_scale[block]=q36_half(d);
    }
    barrier();
    if (l%64==0) a[cache_word(pos,value,true,ch/64)]=
        uintBitsToFloat(kv_scale[block]|(kv_scale[block+1]<<16));
    uint pack=type==1 ? 4 : 8;
    if (l%pack==0) {
        uint bits=0;
        for (uint j=0;j<pack;j++) {
            float v=lanes[l+j], inv=kv_inv[block];
            if (type==1) bits|=(uint(int(roundEven(v*inv)))&255)<<(8*j);
            else bits|=uint(quant4(v,inv))<<(4*j);
        }
        a[cache_word(pos,value,false,ch/pack)]=uintBitsToFloat(bits);
    }
}

float cache_key(uint pos,uint ch) {
    uint packed=floatBitsToUint(d[cache_word(pos,false,false,ch/(2u<<KT))]);
    if (KT==0) return unpackHalf2x16(packed)[ch%2];
    vec2 scales=unpackHalf2x16(floatBitsToUint(d[cache_word(pos,false,true,ch/64)]));
    int q=KT==1 ? bitfieldExtract(int(packed),int(ch%4)*8,8) : int((packed>>(ch%8*4))&15)-8;
    return float(q)*scales[(ch/32)%2];
}

#ifdef INK_FMA
void cache_key_pair(uint key,uint kh,uint lane,out vec2 v[4][4]) {
    [[unroll]] for (uint k=0;k<4;k++) {
        uint ch=kh*128+lane+32*k;
        vec2 sc;
        if (KT!=0) {
            uvec2 scale=kv_pairs[cache_word(key,false,true,ch/64)/2];
            sc=vec2(unpackHalf2x16(scale.x)[k%2],unpackHalf2x16(scale.y)[k%2]);
        }
        [[unroll]] for (uint u=0;u<4;u++) {
            uvec2 packed=kv_pairs[cache_word(key,false,false,(ch+8*u)/(2u<<KT))/2];
            if (KT==0) {
                v[u][k]=vec2(unpackHalf2x16(packed.x)[lane%2],unpackHalf2x16(packed.y)[lane%2]);
            } else {
                ivec2 q=KT==1 ? bitfieldExtract(ivec2(packed),int((lane%4)*8),8) :
                    ivec2((packed>>(4*(lane%8)))&15u)-8;
                v[u][k]=vec2(q)*sc;
            }
        }
    }
}

vec2 score_key_pair(vec2 v[4][4],uint query,uint lane) {
    vec2 dot[4]={vec2(0),vec2(0),vec2(0),vec2(0)};
    [[unroll]] for (uint k=0;k<4;k++) [[unroll]] for (uint u=0;u<4;u++) {
        float q=b[query+lane+8*u+32*k];
        dot[u]=ink_fma(vec4(q),vec4(v[u][k],0,0),vec4(dot[u],0,0)).xy;
    }
    precise vec2 sum=(dot[0]+dot[1])+(dot[2]+dot[3]);
    sum+=subgroupShuffleXor(sum,4); sum+=subgroupShuffleXor(sum,2); sum+=subgroupShuffleXor(sum,1);
    return sum;
}
#endif

vec2 cache_value_at(uint data,uint scale,uint pair) {
    uint packed=floatBitsToUint(c[data]);
    if (VT==0) return unpackHalf2x16(packed);
    vec2 scales=unpackHalf2x16(floatBitsToUint(c[scale]));
    int shift=int(pair%2)*16;
    ivec2 q=VT==1 ? ivec2(bitfieldExtract(int(packed),shift,8),bitfieldExtract(int(packed),shift+8,8)) :
        ivec2((packed>>(pair%4*8))&15,(packed>>(pair%4*8+4))&15)-8;
    return vec2(q)*scales[(pair/16)%2];
}
vec2 cache_value(uint pos,uint pair) {
    return cache_value_at(cache_word(pos,true,false,pair/(1u<<VT)),
                          cache_word(pos,true,true,pair/32),pair);
}
shared vec4 score_query[OP==25 ? 96 : 1];
shared float score_relative[OP==25 ? 48 : 1];
shared vec2 values[OP==24 || OP==8 ? 128 : 1];
vec2 value_sum(vec2 acc,uint l) {
    values[l]=acc; barrier();
    if (l<32) {
        precise vec2 v=(values[l]+values[l+32])+(values[l+64]+values[l+96]);
        values[l]=v;
    }
    barrier();
    precise vec2 v=vec2(0);
    if (l<4) v=((values[l]+values[l+16])+(values[l+8]+values[l+24]))+
               ((values[l+4]+values[l+20])+(values[l+12]+values[l+28]));
    barrier();
    return v;
}
shared float probabilities[8];
shared uint selected[8], starts[128];
void pack_q8(uint dst,uint l,float value,bool valid) {
    lanes[l]=value; barrier();
    float maximum=abs(value);
#ifdef INK_FMA
    for (uint j=16;j!=0;j/=2) maximum=max(maximum,subgroupShuffleXor(maximum,j));
#else
    for (uint j=0;j<32;j++) maximum=max(maximum,abs(lanes[(l&~31u)+j]));
#endif
    float inv=maximum==0 ? 0 : ink_div(127,maximum);
    uint sub=l%32;
    if (valid && sub==0) a[dst]=uintBitsToFloat(q36_half(ink_div(maximum,127)));
    if (valid && sub%4==0) {
        uint packed=0;
        for (uint k=0;k<4;k++) packed|=(uint(int(roundEven(lanes[l+k]*inv)))&255u)<<(8*k);
        a[dst+1+sub/4]=uintBitsToFloat(packed);
    }
}
float routed_output(uint token,uint channel) {
    precise float sum=0;
    for (uint r=0;r<8;r++) {
        uint route=16*token+r;
        float scale=p.k!=0 ? d[floatBitsToUint(c[route])] : 1;
        sum+=(b[(8*token+r)*p.n+channel]*scale)*c[route+8];
    }
    return sum;
}

// Store four successive terms of each host FMA chain in one LDS vector.
// The whole workgroup fetches both vectors even when only eight lanes sum them.
float mix_dot(uint chains,uint token,uint g,uint l) {
    uint src=(p.n-1-g)*width, oc=token*width;
    vec4 state[5]; double ss=0;
    [[unroll]] for (uint k=0;k<5;k++) {
        uint v=k*128+l;
        if (v>=width/4) continue;
        uint base=(v/chains)*(4*chains)+v%chains;
        vec4 q;
        [[unroll]] for (uint i=0;i<4;i++) {
            uint j=base+i*chains;
            state[k][i]=g==p.n ? c[oc+j] : b[token*4*width+src+j];
            q[i]=d[p.k+j];
            if (OP==23 && g==p.n) ss+=square(state[k][i]);
        }
        mix_query[v]=q;
    }
    float scale=1;
    if (OP==23 && g==p.n) scale=inv_norm(total(ss,l),width);
    [[unroll]] for (uint k=0;k<5;k++) {
        uint v=k*128+l;
        if (v>=width/4) continue;
        precise vec4 x=state[k]*scale;
        mix_state[v]=x;
        if (OP==23 && g==p.n) {
            uint base=(v/chains)*(4*chains)+v%chains;
            [[unroll]] for (uint i=0;i<4;i++) e[oc+base+i*chains]=x[i];
        }
    }
    barrier();
    float dot=0;
    if (l<chains) for (uint k=l;k<width/4;k+=chains) {
        vec4 x=mix_state[k], q=mix_query[k];
        [[unroll]] for (uint i=0;i<4;i++) dot=ink_fma(x[i],q[i],dot);
    }
    return dot;
}

#ifdef INK_FMA
shared float route_score[OP==14 ? 32 : 1];
shared uint route_id[OP==14 ? 32 : 1];

void route_merge(inout float score,inout uint id,uint width,uint lane) {
    for (uint shift=width/2;shift!=0;shift/=2) {
        float other_score=subgroupShuffleXor(score,shift);
        uint other_id=subgroupShuffleXor(id,shift);
        bool other_first=other_score>score || (other_score==score && other_id<id);
        bool pick_first=((lane&width)==0)==((lane&shift)==0);
        if (pick_first==other_first) {
            score=other_score;
            id=other_id;
        }
    }
}
#endif

void main() {
    uint l=gl_LocalInvocationID.x, g=gl_WorkGroupID.x+65535*gl_WorkGroupID.y, i=g*128+l;
    uint token=gl_WorkGroupID.z*(OP==30 ? 16 : OP==6 ? 8 : OP==8 ? 2 : 1);
    uint pos=p.n+token;
    uint window=tiled ? 0 : p.k, heads=tiled ? p.k : 24;
    uint first_head=tiled ? p.m : 0; // KV head index
    uint len=window==0 ? pos+1 : min(pos+1,window);
    uint maxlen=window==0 ? p.n+p.u : min(p.n+p.u,window);
    uint oa=0, ob=0, oc=0, od=0, of=0;
    if (OP==0) { oa=token*p.t; ob=token*p.n*p.v; }
    if (OP==1 || OP==23) { oa=token*5; ob=token*4*width; oc=token*width; }
    if (OP==2) { oa=token*width; ob=token*5; oc=token*4*width; od=token*width; }
    if (OP==5) { ob=(token+p.t)*1024; oc=ob; }
    if (OP==6 || OP==25 || OP==30) { oa=token*heads*maxlen; ob=(p.t+token)*3072; oc=(p.t+token)*384; of=(p.t+token)*24; }
    if (OP==7) oa=token*heads*maxlen;
    if (OP==8) { oa=(p.t+token)*3072; ob=token*heads*maxlen; od=oa; }
    if (OP==12) { oa=token*width; ob=oa; oc=oa; od=oa; }
    if (OP==10) { oa=token*8*p.n; ob=oa*2; oc=token*16; }
    if (OP==14) { oa=token*16; ob=token*128; }
    if (OP==0) { // per-head RMS with optional gamma
        double ss=0;
        if (p.n==width) {
            const uint count=width/gl_WorkGroupSize.x;
            float value[count];
            [[unroll]] for (uint k=0;k<count;k++) {
                value[k]=b[ob+gl_WorkGroupSize.x*k+l];
                ss+=square(value[k]);
            }
            float scale=inv_norm(total(ss,l),width);
            [[unroll]] for (uint k=0;k<count;k++) {
                uint j=gl_WorkGroupSize.x*k+l;
                precise float x=value[k]*scale;
                a[oa+p.j+j]=p.k!=0 ? x*c[j] : x;
                if (p.m!=0) a[oa+width+j]=d[(4*token+p.m-1)*width+j]*e[4*token+p.m-1];
            }
        } else {
            float x=l<p.n ? b[ob+g*p.n+l] : 0;
            float scale=inv_norm(total(square(x),l),p.n);
            if (l<p.n) a[oa+g*p.n+l]=x*scale;
        }
    } else if (OP==1 || OP==23) {
        uint chains=p.m!=0 && p.n==3 ? 8 : 32;
        float dot=chains==8 ? mix_dot(8,token,g,l) : mix_dot(32,token,g,l);
#ifdef INK_FMA
        precise float q=dot;
        if (chains==32) {
            q+=subgroupShuffleXor(q,16); q+=subgroupShuffleXor(q,8); q+=subgroupShuffleXor(q,4);
            q+=subgroupShuffleXor(q,1); q+=subgroupShuffleXor(q,2);
        } else { q+=subgroupShuffleXor(q,4); q+=subgroupShuffleXor(q,2); q+=subgroupShuffleXor(q,1); }
        if (l==0) a[oa+g]=q*uintBitsToFloat(p.j);
#else
        lanes[l]=dot; barrier();
        if (l==0) {
            precise float s=0;
            if (chains==8) {
                float q[8]; for (uint j=0;j<8;j++) q[j]=lanes[j];
                s=hsum8(q);
            } else {
                precise float q[8];
                for (uint j=0;j<8;j++) q[j]=(lanes[j]+lanes[j+16])+(lanes[j+8]+lanes[j+24]);
                for (uint j=0;j<4;j++) q[j]+=q[j+4];
                s=(q[0]+q[1])+(q[2]+q[3]);
            }
            a[oa+g]=s*uintBitsToFloat(p.j);
        }
#endif
    } else if (OP==2) {
        float top=b[ob];
        for (uint k=1;k<=p.n;k++) top=max(top,b[ob+k]);
#ifdef INK_FMA
        float prob=q36_router_exp(b[ob+min(gl_SubgroupInvocationID,p.n)]-top);
        double den=0;
        for (uint k=0;k<=p.n;k++) den+=double(subgroupShuffle(prob,k));
        if (l<=p.n) weight[l]=prob*q36_router_round(1.0LF/den);
#else
        if (l==0) {
            double den=0;
            for (uint k=0;k<=p.n;k++) { weight[k]=q36_router_exp(b[ob+k]-top); den+=weight[k]; }
            float inv=q36_router_round(1.0LF/den);
            for (uint k=0;k<=p.n;k++) weight[k]*=inv;
        }
#endif
        barrier();
        precise float sum=0;
        for (uint k=0;k<=p.n;k++) {
            float x=k==p.n ? d[od+i] : c[oc+(p.n-1-k)*width+i];
            if (p.n>=3 && k<4) sum+=x*weight[k]; else sum=ink_fma(x,weight[k],sum);
        }
        a[oa+i]=sum;
    } else if (OP==3 || OP==11) {
        // Each channel belongs to one workgroup. Capture the three samples
        // crossing each time partition before overwriting the in-place input.
