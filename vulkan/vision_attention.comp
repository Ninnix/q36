#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QKV { float qkv[]; };
layout(set = 0, binding = 1) writeonly buffer Output { float outv[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint head_dim;
} pc;

shared float dotv[128];

void main() {
    uint row = gl_WorkGroupID.x;
    uint head = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    uint d = lane;
    uint width = 16u * pc.head_dim;
    uint head_off = head * pc.head_dim;
    uint qbase = row * 3u * width + head_off;
    float scale = pc.head_dim == 64u ? 0.125 : 0.1178511301977579;
    float acc = 0.0;
    float high = -3.402823466e38;
    float denom = 0.0;
    for (uint kr = 0; kr < pc.rows; kr++) {
        uint kbase = kr * 3u * width + width + head_off;
        dotv[lane] = d < pc.head_dim ? qkv[qbase + d] * qkv[kbase + d] : 0.0;
        barrier();
        for (uint stride = 64u; stride != 0u; stride >>= 1u) {
            if (lane < stride) dotv[lane] += dotv[lane + stride];
            barrier();
        }
        float score = dotv[0] * scale;
        float next = max(high, score);
        float old_scale = kr == 0u ? 0.0 : exp(high - next);
        float new_scale = exp(score - next);
        denom = denom * old_scale + new_scale;
        if (d < pc.head_dim) {
            uint vbase = kbase + width;
            acc = acc * old_scale + new_scale * qkv[vbase + d];
        }
        high = next;
        barrier();
    }
    if (d < pc.head_dim)
        outv[row * width + head_off + d] = acc / denom;
}
