#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

/* Two 64-lane row groups serve two tokens and eight GQA heads. Each group
 * owns one token; each lane owns four output dimensions. */

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Qbuf {
    float q[];
};

layout(set = 0, binding = 1) readonly buffer Kcache {
    uint kc[];
};

layout(set = 0, binding = 2) readonly buffer Vcache {
    uint vc[];
};

layout(set = 0, binding = 3) readonly buffer Sinks {
    float sinks[];
};

layout(set = 0, binding = 4) writeonly buffer Partials {
    float part[];
};

layout(push_constant) uniform Push {
    uint pos0;
    uint n_head;
    uint n_head_kv;
    uint head_dim;
    uint n_spans;
    uint n_tok;
    uint has_sinks;
    uint k_type;
    uint v_type;
    uint k_row_bytes;
    uint v_row_bytes;
} pc;

#define TILE 64u
#define SPAN 512u
#define SPAN_GROUP 16u
#define HQ 8u
#define QT 2u
#define HD 256u
#define ROWS 8u
#define VD 4u
#define K_HEAD_BYTES 272u
#define V_HEAD_BYTES 144u

shared float sh_q[QT * HQ * HD];
shared float sh_w[QT * HQ * TILE];

float dot4(vec4 a, vec4 b) {
    return dot(a, b);
}

uint load_v_u8(uint off) {
    return (vc[off >> 2u] >> ((off & 3u) * 8u)) & 255u;
}

float vc_at(uint key, uint kvh, uint i) {
    uint base = key * pc.v_row_bytes + kvh * V_HEAD_BYTES + (i >> 5u) * 18u;
    uint scale = load_v_u8(base) | (load_v_u8(base + 1u) << 8u);
    uint j = i & 31u;
    uint v = load_v_u8(base + 2u + (j & 15u));
    v = j < 16u ? v & 15u : v >> 4u;
    return unpackHalf2x16(scale).x * float(int(v) - 8);
}

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint rg = tid >> 6u;
    uint lane = tid & 63u;
    uint r0 = rg * ROWS;
    uint kvh = gl_WorkGroupID.x;
    uint tok0 = gl_WorkGroupID.y * QT;
    uint tn = min(QT, pc.n_tok - tok0);
    uint max_n_kv = pc.pos0 + tok0 + tn;
    uint group = gl_WorkGroupID.z;
    uint span_first = group * SPAN_GROUP;
    uint max_spans = (max_n_kv + SPAN - 1u) / SPAN;
    uint span_limit = min(span_first + SPAN_GROUP, max_spans);
    if (span_first >= max_spans) return;

    uint h0 = kvh * HQ;
    float scale = 1.0 / sqrt(float(HD));

    for (uint e = tid; e < QT * HQ * HD; e += 128u) {
        uint r = e / HD;
        uint ti = r / HQ;
        uint j = r & (HQ - 1u);
        uint d = e & (HD - 1u);
        sh_q[e] = ti < tn ?
            q[((tok0 + ti) * pc.n_head + h0 + j) * HD + d] : 0.0;
    }
    barrier();

    float gm[ROWS];
    float gl[ROWS];
    float gacc[ROWS][VD];
    for (uint rr = 0u; rr < ROWS; rr++) {
        gm[rr] = -3.402823466e38;
        gl[rr] = 0.0;
        for (uint v = 0u; v < VD; v++) gacc[rr][v] = 0.0;
    }

    for (uint span = span_first; span < span_limit; span++) {
        uint span0 = span * SPAN;
        uint span_end = min(span0 + SPAN, max_n_kv);
        float m[ROWS];
        float l[ROWS];
        float acc[ROWS][VD];
        float nm[ROWS];
        for (uint rr = 0u; rr < ROWS; rr++) {
            uint r = r0 + rr;
            uint ti = r / HQ;
            uint j = r & (HQ - 1u);
            m[rr] = span == 0u && pc.has_sinks != 0u && ti < tn ?
                sinks[h0 + j] : -3.402823466e38;
            l[rr] = 0.0;
            for (uint v = 0u; v < VD; v++) acc[rr][v] = 0.0;
        }

        for (uint base = span0; base < span_end; base += TILE) {
            uint tile_n = min(TILE, span_end - base);

            for (uint kt = 0u; kt < tile_n; kt += 16u) {
                uint key_t = kt + (lane >> 2u);
                uint quad = lane & 3u;
                float dots[ROWS];
                for (uint rr = 0u; rr < ROWS; rr++) dots[rr] = 0.0;
                if (key_t < tile_n) {
                    uint key = base + key_t;
                    uint kb = key * pc.k_row_bytes + kvh * K_HEAD_BYTES;
                    for (uint p = quad; p < 4u; p += 4u) {
                        uint wi = (kb + p * 68u) >> 2u;
                        uint prev = kc[wi];
                        float d0 = unpackHalf2x16(prev).x;
                        float s0[ROWS];
                        float s1[ROWS];
                        for (uint rr = 0u; rr < ROWS; rr++) {
                            s0[rr] = 0.0;
                            s1[rr] = 0.0;
                        }
                        for (uint k = 0u; k < 8u; k++) {
                            uint next = kc[wi + 1u + k];
                            uint sw = (prev >> 16u) | (next << 16u);
                            prev = next;
                            vec4 kv = vec4(unpack8(int(sw)));
                            uint qi = p * 64u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint qb = (r0 + rr) * HD + qi;
                                s0[rr] += dot4(kv, vec4(sh_q[qb], sh_q[qb + 1u],
                                                       sh_q[qb + 2u], sh_q[qb + 3u]));
                            }
                        }
                        float d1 = unpackHalf2x16(prev).y;
                        for (uint k = 0u; k < 8u; k++) {
                            vec4 kv = vec4(unpack8(int(kc[wi + 9u + k])));
                            uint qi = p * 64u + 32u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint qb = (r0 + rr) * HD + qi;
                                s1[rr] += dot4(kv, vec4(sh_q[qb], sh_q[qb + 1u],
                                                       sh_q[qb + 2u], sh_q[qb + 3u]));
                            }
                        }
                        for (uint rr = 0u; rr < ROWS; rr++)
                            dots[rr] += d0 * s0[rr] + d1 * s1[rr];
                    }
                }
                for (uint rr = 0u; rr < ROWS; rr++) {
                    uint r = r0 + rr;
                    uint ti = r / HQ;
                    uint n_kv = pc.pos0 + tok0 + ti + 1u;
                    float d = ti < tn && base + key_t < n_kv ? dots[rr] : 0.0;
                    d = subgroupClusteredAdd(d, 4u);
                    if ((lane & 3u) == 0u && key_t < tile_n &&
                        ti < tn && base + key_t < n_kv)
                        sh_w[r * TILE + key_t] = d * scale;
                }
            }
            barrier();

            for (uint rr = 0u; rr < ROWS; rr++) {
                uint r = r0 + rr;
                uint ti = r / HQ;
                uint n_kv = pc.pos0 + tok0 + ti + 1u;
                uint row_tile_n = ti < tn && base < n_kv ?
                    min(TILE, n_kv - base) : 0u;
                if (row_tile_n == 0u) {
                    nm[rr] = m[rr];
                    continue;
                }
                float tmax = -3.402823466e38;
                for (uint t = 0u; t < row_tile_n; t++)
                    tmax = max(tmax, sh_w[r * TILE + t]);
                float n = max(m[rr], tmax);
                float rs = exp(m[rr] - n);
                l[rr] *= rs;
                for (uint v = 0u; v < VD; v++) acc[rr][v] *= rs;
                nm[rr] = n;
            }
            barrier();

            for (uint rr = 0u; rr < ROWS; rr++) {
                uint r = r0 + rr;
                uint ti = r / HQ;
                uint n_kv = pc.pos0 + tok0 + ti + 1u;
                uint row_tile_n = ti < tn && base < n_kv ?
                    min(TILE, n_kv - base) : 0u;
                for (uint t = lane; t < row_tile_n; t += 64u)
                    sh_w[r * TILE + t] = exp(sh_w[r * TILE + t] - nm[rr]);
            }
            barrier();

            float vv[VD];
            for (uint t = 0u; t < tile_n; t++) {
                for (uint v = 0u; v < VD; v++)
                    vv[v] = vc_at(base + t, kvh, lane + v * 64u);
                for (uint rr = 0u; rr < ROWS; rr++) {
                    uint r = r0 + rr;
                    uint ti = r / HQ;
                    uint n_kv = pc.pos0 + tok0 + ti + 1u;
                    if (ti >= tn || base + t >= n_kv) continue;
                    float w = sh_w[r * TILE + t];
                    l[rr] += w;
                    for (uint v = 0u; v < VD; v++) acc[rr][v] += w * vv[v];
                }
            }
            for (uint rr = 0u; rr < ROWS; rr++) m[rr] = nm[rr];
            barrier();
        }

        for (uint rr = 0u; rr < ROWS; rr++) {
            uint r = r0 + rr;
            uint ti = r / HQ;
            uint n_kv = pc.pos0 + tok0 + ti + 1u;
            if (ti >= tn || span0 >= n_kv) continue;
            if (span == span_first) {
                gm[rr] = m[rr];
                gl[rr] = l[rr];
                for (uint v = 0u; v < VD; v++) gacc[rr][v] = acc[rr][v];
            } else {
                float n = max(gm[rr], m[rr]);
                float rp = exp(gm[rr] - n);
                float rs = exp(m[rr] - n);
                gl[rr] = gl[rr] * rp + l[rr] * rs;
                for (uint v = 0u; v < VD; v++)
                    gacc[rr][v] = gacc[rr][v] * rp + acc[rr][v] * rs;
                gm[rr] = n;
            }
        }
        barrier();
    }

    for (uint rr = 0u; rr < ROWS; rr++) {
        uint r = r0 + rr;
        uint ti = r / HQ;
        uint j = r & (HQ - 1u);
        uint tok = tok0 + ti;
        uint n_kv = pc.pos0 + tok + 1u;
        uint row_spans = (n_kv + SPAN - 1u) / SPAN;
        if (ti >= tn || span_first >= row_spans) continue;
        uint pbase = ((tok * pc.n_head + h0 + j) *
                      pc.n_spans + group) * (HD + 2u);
        for (uint v = 0u; v < VD; v++)
            part[pbase + lane + v * 64u] = gacc[rr][v];
        if (lane == 0u) {
            part[pbase + HD] = gm[rr];
            part[pbase + HD + 1u] = gl[rr];
        }
    }
}
