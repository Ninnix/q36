            float theta = float(group * 4) * pow(1e7, -float(2 * lane) / 64.0);
            float x = vals[lane], y = vals[lane + 32];
            vals[lane] = x * cos(theta) - y * sin(theta); vals[lane + 32] = x * sin(theta) + y * cos(theta);
        }
        barrier();
        }
