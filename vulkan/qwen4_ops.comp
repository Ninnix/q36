            if (lane<128) vals[lane]=B(group*512+lane);
            barrier();
        } else {
        float pooled = 0;
        if (lane < 128) for (uint t = 0; t < 4; t++) pooled += B((group * 4 + t) * 128 + lane) * 0.25;
        double ss=reduce(double(pooled)*pooled);
        if (lane==0) norm_scale[0]=q36_rsqrt(float(ss/128.0)+1e-6);
        barrier();
        float scale=norm_scale[0];
        if (lane < 128) vals[lane] = pooled * scale * D(lane);
        barrier();
