#version 460
#extension GL_GOOGLE_include_directive : require
#ifdef Q36_ROUTER_SUBGROUP
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#include "reference_math.glsl"
#include "expf.glsl"
#ifndef Q36_LOCAL_SIZE
#define Q36_LOCAL_SIZE 256
#endif
layout(local_size_x = Q36_LOCAL_SIZE) in;
layout(constant_id = 0) const uint OP_KIND=0;
layout(binding = 0) buffer A { float a[]; };
layout(binding = 1) buffer B { float b[]; };
layout(binding = 2) buffer C { float c[]; };
layout(binding = 3) buffer D { float d[]; };
layout(binding = 4) buffer E { float e[]; };
layout(binding = 5) buffer F { float f[]; };
layout(push_constant) uniform Push { uint op, n, rows, pos, cap, aux, type, mode; } p;
#define OP (OP_KIND==0 ? p.op : OP_KIND-1)
shared double sums[256];
shared float norm_scale[2];
shared double attention_denom;
shared float attention_max;
shared float vals[OP_KIND!=0 && OP_KIND!=13 && OP_KIND!=29 ? 256 : 2052];
shared uint ids[256];
shared uint qsa_score, qsa_index, qsa_mask, qsa_rank, qsa_nan;
uint qsa_key(float score) {
    uint bits=floatBitsToUint(score==0 ? 0.0 : score);
    return (bits & 0x80000000u)!=0 ? ~bits : bits ^ 0x80000000u;
}
float sig(float v) { return q36_sigmoid(v); }
float silu(float v) { return q36_silu(v); }
double reduce(double v) {
    uint l = gl_LocalInvocationID.x;
    sums[l] = v; barrier();
    for (uint j = 128; j > 0; j /= 2) { if (l < j) sums[l] += sums[l + j]; barrier(); }
    double result = sums[0];
