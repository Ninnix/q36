}
uint offset_a, offset_b, offset_c, offset_d, offset_e, offset_f;
#define A(i) a[offset_a+(i)]
#define B(i) b[offset_b+(i)]
#define C(i) c[offset_c+(i)]
#define D(i) d[offset_d+(i)]
#define E(i) e[offset_e+(i)]
#define F(i) f[offset_f+(i)]
uint row_offset(uint binding, uint token) {
