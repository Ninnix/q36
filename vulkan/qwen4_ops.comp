void main() {
    uint lane = gl_LocalInvocationID.x;
    uint group = p.cap != 0 ? gl_WorkGroupID.x : gl_WorkGroupID.x + gl_WorkGroupID.y * 65535;
    uint i = group * gl_WorkGroupSize.x + lane, token = p.cap != 0 ? gl_WorkGroupID.y : 0;
    offset_a=row_offset(0,token); offset_b=row_offset(1,token); offset_c=row_offset(2,token);
    offset_d=row_offset(3,token); offset_e=row_offset(4,token); offset_f=row_offset(5,token);
