#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    float scale;
} pc;

#ifndef Q36_ROWS
#define Q36_ROWS 5
#endif
#ifndef Q36_BOUNDS
#define Q36_BOUNDS 1
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ3XXS_GRID = 3104u;

shared uint grid_lut[256];
shared uint signs_lut[128];

uint load_u8(uint off) {
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
}

uint load_u16(uint off) {
    return uint(wh[off >> 1u]);
}

uint load_u32(uint off) {
    uint i = off >> 1u;
    return uint(wh[i]) | (uint(wh[i + 1u]) << 16u);
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[ROWS];
    for (uint r = 0u; r < ROWS; r++) acc[r] = 0.0;
    for (uint i = lid; i < 256u; i += 64u)
        grid_lut[i] = tables[TAB_IQ3XXS_GRID + i];
    for (uint i = lid; i < 128u; i += 64u) {
        uint packed = tables[TAB_KSIGNS + (i >> 2u)];
        signs_lut[i] = (packed >> ((i & 3u) * 8u)) & 255u;
    }
    barrier();

    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        uint qbase = b * Q8K_WORDS;
        vec4 qv[8];
        for (uint l = 0u; l < 8u; l++)
            qv[l] = unpack_i8(q8[qbase + 2u + 8u * itid + l]);
        float yd = uintBitsToFloat(q8[qbase]);
        uint ib = itid;

        for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            uint base = row * pc.row_bytes + 98u * b;
            uint aux = load_u32(base + 66u + 4u * ib);
            float sum = 0.0;
            for (uint part = 0u; part < 2u; part++) {
                uint qs = load_u32(base + 2u + 8u * ib + 4u * part);
                for (uint l = 0u; l < 2u; l++) {
                    uint signs = signs_lut[
                        (aux >> (7u * (2u * part + l))) & 127u];
                    uint grid0 = grid_lut[(qs >> (16u * l)) & 255u];
                    uint grid1 = grid_lut[(qs >> (16u * l + 8u)) & 255u];
                    vec4 w0 = unpack_i8(grid0) * vec4(
                        (signs & 1u) != 0u ? -1.0 : 1.0,
                        (signs & 2u) != 0u ? -1.0 : 1.0,
                        (signs & 4u) != 0u ? -1.0 : 1.0,
                        (signs & 8u) != 0u ? -1.0 : 1.0);
                    signs >>= 4u;
                    vec4 w1 = unpack_i8(grid1) * vec4(
                        (signs & 1u) != 0u ? -1.0 : 1.0,
                        (signs & 2u) != 0u ? -1.0 : 1.0,
                        (signs & 4u) != 0u ? -1.0 : 1.0,
                        (signs & 8u) != 0u ? -1.0 : 1.0);
                    uint q = 4u * part + 2u * l;
                    vec4 q0 = qv[q];
                    vec4 q1 = qv[q + 1u];
                    sum = fma(w0.x, q0.x,
                          fma(w0.y, q0.y,
                          fma(w0.z, q0.z,
                          fma(w0.w, q0.w,
                          fma(w1.x, q1.x,
                          fma(w1.y, q1.y,
                          fma(w1.z, q1.z,
                          fma(w1.w, q1.w, sum))))))));
                }
            }
            int ls = 2 * int(aux >> 28u) + 1;
            float wd = unpackHalf2x16(load_u16(base)).x;
            acc[r] = fma(wd * yd * float(ls), sum, acc[r]);
        }
    }

    for (uint r = 0u; r < ROWS; r++) {
        float total = subgroupAdd(acc[r]);
        uint row = first_row + r;
        if (lid == 0u
#if Q36_BOUNDS
            && row < pc.out_dim
#endif
        )
            y[row] = total * (0.25 * pc.scale);
    }
}
