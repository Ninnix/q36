#version 460
#ifdef Q36_STATE_F16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#ifdef Q36_STATE_F16
layout(set = 0, binding = 0) buffer State { float16_t s[]; };
#else
layout(set = 0, binding = 0) buffer State { float s[]; };
#endif
layout(set = 0, binding = 1) readonly buffer Qbuf { float q[]; };
layout(set = 0, binding = 2) readonly buffer Kbuf { float k[]; };
layout(set = 0, binding = 3) readonly buffer Vbuf { float v[]; };
layout(set = 0, binding = 4) readonly buffer GB { float gb[]; };
layout(set = 0, binding = 5) writeonly buffer Output { float y[]; };
#ifdef Q36_STATE_SOURCE
layout(constant_id = 0) const bool STATE_ONLY = false;
#ifdef Q36_STATE_F16
layout(set = 0, binding = 6) readonly buffer Initial { float16_t initial[]; };
#else
layout(set = 0, binding = 6) readonly buffer Initial { float initial[]; };
#endif
#else
#define initial s
#endif

layout(push_constant) uniform Push {
    uint n_heads;
    uint state_dim;
    uint n_tok;
} pc;

const uint N = 128u;
const uint LANES = 8u;
const uint COLS = 8u;
const uint ROWS = N / LANES;

#ifdef Q36_MTP_VERIFY
/* RADV may remove a float16 cast round trip, and packHalf can round toward
 * zero. Round the bits to match the scalar kernel's half stores instead. */
float round_state(float v) {
    uint bits = floatBitsToUint(v), a = bits & 0x7fffffffu;
    uint sign = bits & 0x80000000u;
    if (a >= 0x7f800000u) return v;
    if (a <= 0x33000000u) return uintBitsToFloat(sign);
    if (a < 0x33800000u) return uintBitsToFloat(sign | 0x33800000u);
    uint shift = max(13u, 126u - min(a >> 23u, 126u));
    uint mask = (1u << shift) - 1u;
    a = (a + (mask >> 1u) + ((a >> shift) & 1u)) & ~mask;
    if (a >= 0x47800000u) a = 0x7f800000u;
    return uintBitsToFloat(sign | a);
}
#endif

void main(void) {
    uint h = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint lane = lid & (LANES - 1u);
    uint j = gl_WorkGroupID.y * COLS + lid / LANES;
    if (h >= pc.n_heads || pc.state_dim != N) return;

    uint mat = h * N * N;
    float state[ROWS];
    for (uint r = 0u; r < ROWS; r++)
        state[r] = float(initial[mat + (r * LANES + lane) * N + j]);

    float norm = inversesqrt(float(N));
    for (uint tok = 0u; tok < pc.n_tok; tok++) {
#ifdef Q36_STRIDED
        uint vec=tok*16384u+h*N, value_offset=4096u;
        uint control=tok*16384u;
#else
        uint vec=tok*pc.n_heads*N+h*N, value_offset=0;
        uint control=tok*2u*pc.n_heads;
#endif
        float decay=gb[control+h];
        float beta=gb[control+pc.n_heads+h];
        float qr[ROWS];
        float kr[ROWS];
        float sk = 0.0;
        for (uint r = 0u; r < ROWS; r++) {
            uint i = r * LANES + lane;
            kr[r] = k[vec + i];
#ifdef Q36_STATE_SOURCE
            if (!STATE_ONLY)
#endif
                qr[r] = q[vec + i];
            state[r] *= decay;
            sk = fma(state[r], kr[r], sk);
        }
        sk = subgroupClusteredAdd(sk, LANES);
        float d = (v[vec + value_offset + j] - sk) * beta;
        float outj = 0.0;
        for (uint r = 0u; r < ROWS; r++) {
            state[r] = fma(kr[r], d, state[r]);
#ifdef Q36_STATE_SOURCE
            if (!STATE_ONLY)
#endif
                outj = fma(state[r], qr[r], outj);
        }
#ifdef Q36_STATE_SOURCE
        if (!STATE_ONLY) {
#endif
            outj = subgroupClusteredAdd(outj, LANES);
            if (lane == 0u) y[vec + j] = outj * norm;
#ifdef Q36_STATE_SOURCE
        }
#endif
#ifdef Q36_MTP_VERIFY
        /* Plain decode stores half state after every token. Keep that rounding
         * while retaining the state in registers across the verify window. */
        if (tok + 1u < pc.n_tok)
            for (uint r = 0u; r < ROWS; r++) state[r] = round_state(state[r]);
#endif
    }

    for (uint r = 0u; r < ROWS; r++) {
#ifdef Q36_STATE_F16
        s[mat + (r * LANES + lane) * N + j] = float16_t(state[r]);
#else
        s[mat + (r * LANES + lane) * N + j] = state[r];
#endif
    }
}
