// Register-block two rows so every activation load feeds two dot products.
void block_tile(uint tile,uint tile_row,uint lane,uint nt,uint mode) {
    uint desc=16*nt+1+9*tile, row=16*tile_row+gl_LocalInvocationID.x/8;
    if (row>=p.rows || (mode!=0 && tile>=ids[16*nt])) return;
    wbase=mode!=0 ? (ids[desc]&127u)*p.rows*p.stride : 0;
    bool iq=TYPE==16 || TYPE==17 || TYPE==18 || TYPE==22;
    uint blocks=iq ? WIDTH/256 : WIDTH/32, span=blocks*(iq ? 74 : 9);
    uint bytes=TYPE==16 ? 66 : TYPE==17 ? 74 : TYPE==18 ? 98 : 82;
    [[unroll]] for (uint t=0;t<8;t++) {
        path[t]=mode!=0 ? ids[desc+1+t] : 8*tile+t<nt ? 8*tile+t : ~0u;
        uint id=path[t]==~0u ? path[0] : path[t];
        input_base[t]=(mode==1 ? id/8 : id)*span;
    }
    bool second=path[4]!=~0u;
    float result[2][8];
    [[unroll]] for (uint r=0;r<2;r++) [[unroll]] for (uint t=0;t<8;t++) result[r][t]=0;
    for (uint b=0;b<blocks;b++) {
        int dots[2][8];
        [[unroll]] for (uint r=0;r<2;r++) [[unroll]] for (uint t=0;t<8;t++) dots[r][t]=0;
        float ws[2];
        [[unroll]] for (uint g=0;g<(iq ? 8 : 1);g++) {
            int weight[2], mult[2];
            [[unroll]] for (uint r=0;r<2;r++) {
                weight[r]=tile_weight(row+8*r,b,g,lane,iq,bytes,mult[r],ws[r]);
            }
            [[unroll]] for (uint t=0;t<8;t++) if (t<4 || second) {
                uint xoff=input_base[t]+(iq ? 74*b+2+8*g : 9*b+1)+lane;
                uint act=x[xoff];
                [[unroll]] for (uint r=0;r<2;r++) dots[r][t]+=mult[r]*dot4(weight[r],act);
            }
        }
        [[unroll]] for (uint t=0;t<8;t++) if (t<4 || second) {
            uint xw=x[input_base[t]+(iq ? 74 : 9)*b];
            float scale=iq ? uintBitsToFloat(xw) : unpackHalf2x16(xw).x;
            [[unroll]] for (uint r=0;r<2;r++) result[r][t]=ink_fma(ws[r]*scale,float(dots[r][t]),result[r][t]);
        }
    }
    uint l=gl_LocalInvocationID.x;
    [[unroll]] for (uint r=0;r<2;r++) {
#ifdef INK_FMA
        [[unroll]] for (uint t=0;t<8;t++) if (t<4 || second) {
            precise float v=result[r][t];
            v+=subgroupShuffleXor(v,4); v+=subgroupShuffleXor(v,2); v+=subgroupShuffleXor(v,1);
            if (lane==0 && path[t]!=~0u) y[path[t]*p.rows+row+8*r]=TYPE==18 ? v*0.25 : v;
        }
#else
        tile_sum[l]=vec4(result[r][0],result[r][1],result[r][2],result[r][3]);
        if (second) tile_extra[l]=vec4(result[r][4],result[r][5],result[r][6],result[r][7]);
        barrier();
        if (lane<4) { tile_sum[l]+=tile_sum[l+4]; if (second) tile_extra[l]+=tile_extra[l+4]; }
        barrier();
        if (lane==0) {
            precise vec4 v=(tile_sum[l]+tile_sum[l+2])+(tile_sum[l+1]+tile_sum[l+3]);
            [[unroll]] for (uint t=0;t<4;t++) if (path[t]!=~0u) y[path[t]*p.rows+row+8*r]=TYPE==18 ? v[t]*0.25 : v[t];
            if (second) {
                v=(tile_extra[l]+tile_extra[l+2])+(tile_extra[l+1]+tile_extra[l+3]);
                [[unroll]] for (uint t=0;t<4;t++) if (path[t+4]!=~0u) y[path[t+4]*p.rows+row+8*r]=TYPE==18 ? v[t]*0.25 : v[t];
            }
        }
        barrier();
#endif
    }
}
// Unpack each K-quant word once for the whole token tile. Keep the minimum
// correction on its original lanes until the final reduction.
void k_tile(uint paths,uint tile,uint row,uint lane,uint nt,uint mode,bool paired) {
#ifdef INK_MIN_TILE
    const bool separate_min=true;
#else
    const bool separate_min=false;
#endif
    uint id[16], input_at[16], bytes=TYPE==12 ? 144 : TYPE==13 ? 176 : 210;
    if (mode!=0) {
        uint base=16*nt+1+9*(tile/2);
        if (tile/2>=ids[16*nt]) return;
        wbase=(ids[base]&127u)*p.rows*p.stride;
        [[unroll]] for (uint t=0;t<paths;t++) id[t]=ids[base+1+4*(tile%2)+t];
    } else {
        wbase=0;
        [[unroll]] for (uint t=0;t<paths;t++) id[t]=paths*tile+t<nt ? paths*tile+t : ~0u;
    }
    if (id[0]==~0u) return;
    float sum[16], minimum[16];
    [[unroll]] for (uint t=0;t<paths;t++) {
        uint src=id[t]==~0u ? id[0] : id[t];
        input_at[t]=(mode==1 ? src/8 : src)*(WIDTH/256)*74;
        sum[t]=0; minimum[t]=0;
    }
    for (uint b=0;b<WIDTH/256;b++) {
        uint off=row*p.stride+b*bytes;
        uint panel=(tile*(paths/8)*(WIDTH/256)+b)*1096;
        float partial[16]; int dot[16], minus[16];
        [[unroll]] for (uint t=0;t<paths;t++) { partial[t]=0; dot[t]=0; minus[t]=0; }
        [[unroll]] for (uint g=0;g<8;g++) {
            int sc,mn=0;
            if (TYPE==14) sc=int(byte_at(off+192+2*g+lane/4)^128u)-128;
            else if (g<4) { sc=int(byte_at(off+4+g)&63u); mn=int(byte_at(off+8+g)&63u); }
            else {
                sc=int((byte_at(off+8+g)&15u)|((byte_at(off+g)>>6)<<4));
                mn=int((byte_at(off+8+g)>>4)|((byte_at(off+4+g)>>6)<<4));
            }
            int code=int(k_codes(TYPE,off,g,lane));
            if (paired) {
                vec4 weight;
                [[unroll]] for (uint k=0;k<4;k++) weight[k]=float(sc*bitfieldExtract(code,int(8*k),8));
                [[unroll]] for (uint t=0;t<paths/2;t++) {
                    uint at=panel+(t/4)*(WIDTH/256)*1096+8+128*g+32*(t%4)+lane;
                    [[unroll]] for (uint j=0;j<2;j++) if (TYPE==14 && g==4) {
                        // Sixteen Q6 products always fit the binary32 integer significand.
                        dot[2*t+j]=int(partial[2*t+j]); partial[2*t+j]=0;
                    }
                    [[unroll]] for (uint k=0;k<4;k++) {
                        vec2 act=unpackHalf2x16(x[at+8*k]);
                        partial[2*t]=fma(weight[k],act.x,partial[2*t]);
                        partial[2*t+1]=fma(weight[k],act.y,partial[2*t+1]);
                    }
                }
            }
            [[unroll]] for (uint t=0;t<paths;t++) {
                uint xb=mode==0 ? (min(tile*paths+t,nt-1)*(WIDTH/256)+b)*74 : input_at[t]+b*74;
                if (!paired) dot[t]+=sc*dot4(code,x[xb+2+8*g+lane]);
                if (!separate_min && ((TYPE==12 && lane==g/2) || (TYPE==13 && lane==0))) {
                    int bs=int(x[paired ? panel+(t/8)*(WIDTH/256)*1096+1032+8*g+t%8 : xb+66+g]);
                    minus[t]+=mn*(bitfieldExtract(bs,0,16)+bitfieldExtract(bs,16,16));
                }
            }
        }
#ifdef INK_MIN_TILE
        // Two groups feed each Q4 minimum lane. For Q5, sum the eight
        // integer corrections before the original lane-zero FMA.
        if (TYPE!=14) {
            uint first=TYPE==12 ? 2*lane : lane;
            uint groups=TYPE==12 ? 2 : 1;
            int m[2];
            [[unroll]] for (uint j=0;j<groups;j++) {
                uint g=first+j;
                m[j]=int(g<4 ? (byte_at(off+8+g)&63u) :
                            (byte_at(off+8+g)>>4)|((byte_at(off+4+g)>>6)<<4));
            }
            if (TYPE==13 || lane<4) [[unroll]] for (uint t=0;t<paths;t++) {
                uint xb=mode==0 ? (min(tile*paths+t,nt-1)*(WIDTH/256)+b)*74 : input_at[t]+b*74;
                uint bp=paired ? panel+(t/8)*(WIDTH/256)*1096+1032+t%8 : xb+66;
                int part=0;
                [[unroll]] for (uint j=0;j<groups;j++) {
                    uint g=first+j;
                    int word=int(x[bp+(paired ? 8*g : g)]);
                    part+=m[j]*(bitfieldExtract(word,0,16)+(word>>16));
                }
                if (TYPE==13) {
                    part+=subgroupShuffleXor(part,4);
                    part+=subgroupShuffleXor(part,2);
                    part+=subgroupShuffleXor(part,1);
                    if (lane!=0) part=0;
                }
                minus[t]=part;
            }
        }
#endif
        float ws=unpackHalf2x16(halfword(off+(TYPE==14 ? 208 : 0))).x;
        float ms=TYPE==14 ? 0 : -unpackHalf2x16(halfword(off+2)).x;
        [[unroll]] for (uint t=0;t<paths;t++) {
            uint xb=mode==0 ? (min(tile*paths+t,nt-1)*(WIDTH/256)+b)*74 : input_at[t]+b*74;
            if (paired) { dot[t]+=int(partial[t]); xb=panel+(t/8)*(WIDTH/256)*1096+t%8; }
            if (TYPE==14) {
                int bs=int(x[xb+(paired ? 1032+8*lane : 66+lane)]);
                dot[t]-=32*((int(byte_at(off+192+2*lane)^128u)-128)*bitfieldExtract(bs,0,16)+
                            (int(byte_at(off+193+2*lane)^128u)-128)*bitfieldExtract(bs,16,16));
            }
            float xd=uintBitsToFloat(x[xb]);
            sum[t]=ink_fma(ws*xd,float(dot[t]),sum[t]);
            if (TYPE!=14) minimum[t]=ink_fma(ms*xd,float(minus[t]),minimum[t]);
        }
    }
    [[unroll]] for (uint t=0;t<paths;t++) {
        precise float v=sum[t], m=minimum[t];
#ifdef INK_FMA
        v+=subgroupShuffleXor(v,4); v+=subgroupShuffleXor(v,2); v+=subgroupShuffleXor(v,1);
        if (TYPE!=14) { m+=subgroupShuffleXor(m,2); m+=subgroupShuffleXor(m,1); v+=m; }
#else
        uint l=gl_LocalInvocationID.x;
        sums[l]=v; mins[l]=m; barrier();
        if (lane==0) {
            v=((sums[l]+sums[l+4])+(sums[l+2]+sums[l+6]))+
              ((sums[l+1]+sums[l+5])+(sums[l+3]+sums[l+7]));
            if (TYPE!=14) v+=(mins[l]+mins[l+2])+(mins[l+1]+mins[l+3]);
        }
        barrier();
#endif
        if (lane==0 && id[t]!=~0u) y[id[t]*p.rows+row]=v;
    }
}
void main() {
#ifdef INK_IQ_TILE_I16
    uint tile=gl_WorkGroupID.x/8, nt=p.route>>8;
    if (tile>=ids[16*nt]) return;
    uint desc=16*nt+1+9*tile, flags=ids[desc];
    if ((flags&256u)!=0) return;
    if ((flags&128u)!=0) paired_tile(16,4);
    else if (ids[desc+5]==~0u) paired_tile(4,4);
    else paired_tile(8,4);
#else
    if (TYPE>=12 && TYPE<=14) {
        uint tile=gl_WorkGroupID.x/8, lane=gl_LocalInvocationID.x%8;
        uint row=(gl_WorkGroupID.y*8+gl_WorkGroupID.x%8)*8+gl_LocalInvocationID.x/8;
        uint nt=p.route>>8, mode=p.route&15u;
        if (row>=p.rows) return;
        if ((p.route&16u)!=0) {
            if (nt%16==0) k_tile(16,tile,row,lane,nt,0,true);
            else k_tile(8,tile,row,lane,nt,0,true);
        } else if (mode!=0) k_tile(4,tile,row,lane,nt,mode,false);
        else k_tile(TYPE==14 ? 16 : 8,tile,row,lane,nt,0,false);
        return;
    }
    if (TYPE==20) { iq4_tile(); return; }
    if ((p.route&16u)!=0) {
        uint tile=gl_WorkGroupID.x/8, nt=p.route>>8;
        bool routed=(p.route&15u)!=0;
        if (routed && tile>=ids[16*nt]) return;
        uint desc=16*nt+1+9*tile;
        if (routed && (p.route&32u)!=0 && (ids[desc]&256u)!=0) return;
#if defined(INK_FMA) && defined(INK_HALF_WEIGHT)
        if (nv_tile) {
            if ((ids[desc]&128u)!=0) nvfp4_tile(16,desc,tile);
            else if (ids[desc+5]==~0u) nvfp4_tile(4,desc,tile);
            else nvfp4_tile(8,desc,tile);
            return;
        }
#endif
        if (TYPE==8 && (p.route&64u)!=0) paired_tile(16,4);
        else if ((p.route&32u)!=0 && (!routed || (ids[desc]&128u)!=0)) paired_tile(16,3);
        else if (routed && ids[desc+5]==~0u) paired_tile(4,4);
        else paired_tile(8,4);
        return;
    }
    uint tile=gl_WorkGroupID.x/8, nt=p.route>>8, mode=p.route&255u;
    uint tile_row=gl_WorkGroupID.y*8+gl_WorkGroupID.x%8, lane=gl_LocalInvocationID.x%8;
    bool iq=TYPE==16 || TYPE==17 || TYPE==18 || TYPE==22;
    if ((iq || TYPE==8 || TYPE==40) && p.rows%16==0) {
        block_tile(tile,tile_row,lane,nt,mode);
        return;
    }
    uint row=tile_row*8+gl_LocalInvocationID.x/8;
    if ((row&~7u)>=p.rows) return;
    bool packed=iq || TYPE==8 || TYPE==40;
    uint span=packed ? (iq ? WIDTH/256*74 : WIDTH/32*9) : WIDTH;
    if (mode!=0) {
        uint base=nt*16;
        uint half_tile=tile%2;
        tile/=2;
        if (tile>=ids[base]) return;
        uint desc=base+1+9*tile;
        wbase=(ids[desc]&127u)*p.rows*p.stride;
        [[unroll]] for (uint t=0;t<4;t++) path[t]=ids[desc+1+4*half_tile+t];
        if (path[0]==~0u) return;
    } else {
        wbase=0;
