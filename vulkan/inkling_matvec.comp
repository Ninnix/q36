    }
    [[unroll]] for (uint t=0;t<4;t++) {
        uint idx=path[t]==~0u ? path[0] : path[t];
        row_out[t]=idx*p.rows+row;
        input_base[t]=(mode==1 ? idx/8 : idx)*span;
    }
