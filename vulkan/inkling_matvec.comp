        uint off=row*p.stride+b*bytes, xb=b*74, sub=lane/2;
        float d=iq_scale(row,b,bytes,off);
        if (t!=18) d*=0.125;
        int acc=0;
        [[unroll]] for (uint g=0;g<8;g++) {
            uint sc;
            int grid=iq_grid(t,off,row,b,g,lane,sc);
            acc+=int(2*sc+1)*dot4(grid,x[xbase+xb+2+8*g+lane]);
        }
        sum=ink_fma(d*uintBitsToFloat(x[xbase+xb]),float(acc),sum);
