float k_row(uint row,uint lane,out float minimum) {
    uint t=TYPE, bytes=t==12 ? 144 : t==13 ? 176 : 210;
    float sum=0; minimum=0;
    for (uint b=0;b<WIDTH/256;b++) {
        uint off=row*p.stride+b*bytes, xb=b*74;
        int acc=0, mins=0;
        for (uint g=0;g<8;g++) {
            uint sx=4*lane;
            int sc, mn=0;
            if (t==14) sc=int(byte_at(off+192+2*g+sx/16)^128u)-128;
            else if (g<4) { sc=int(byte_at(off+4+g)&63u);mn=int(byte_at(off+8+g)&63u); }
            else {
                sc=int((byte_at(off+8+g)&15u)|((byte_at(off+g)>>6)<<4));
                mn=int((byte_at(off+8+g)>>4)|((byte_at(off+4+g)>>6)<<4));
            }
            uint act=x[xbase+xb+2+8*g+lane];
            acc+=sc*dot4(int(k_codes(t,off,g,lane)),act);
            if ((t==12 && lane==g/2) || (t==13 && lane==0))
                mins+=mn*(bsum(xb,2*g)+bsum(xb,2*g+1));
        }
        float xd=uintBitsToFloat(x[xbase+xb]);
        if (t==14) {
            for (uint k=2*lane;k<=2*lane+1;k++)
                acc-=32*(int(byte_at(off+192+k)^128u)-128)*bsum(xb,k);
        } else minimum=ink_fma(-unpackHalf2x16(halfword(off+2)).x*xd,float(mins),minimum);
        float d=unpackHalf2x16(halfword(off+(t==14 ? 208 : 0))).x*xd;
        sum=ink_fma(d,float(acc),sum);
    }
    return sum;
}
