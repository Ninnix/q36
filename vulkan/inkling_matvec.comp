int iq_grid(uint t,uint off,uint row,uint block,uint g,uint lane,out uint sc) {
#ifdef INK_DOT
    uint signs, grid=iq_index(t,row,block,g,lane,signs,sc);
    return signed_grid(tables[grid],signs);
#else
