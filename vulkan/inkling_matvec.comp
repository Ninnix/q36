#else
    return unpackHalf2x16(halfword(off)).x;
#endif
}
float iq_row(uint row,uint lane) {
    uint t=TYPE, bytes=t==16 ? 66 : t==17 ? 74 : t==18 ? 98 : 82;
    float sum=0;
