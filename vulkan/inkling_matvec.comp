int bsum(uint xb,uint i) { return bitfieldExtract(int(x[xbase+xb+66+i/2]),int(16*(i%2)),16); }
uint k_codes(uint t,uint off,uint g,uint lane) {
    uint j=4*lane;
    if (t==14) {
        uint lo=word(off+(g/4)*64+(g%2)*32+j), hi=word(off+128+(g/4)*32+j);
        return ((lo>>(4*((g%4)/2)))&0x0f0f0f0fu)|(((hi>>(2*(g%4)))&0x03030303u)<<4);
    }
    uint lo=(word(off+(t==12 ? 16 : 48)+(g/2)*32+j)>>(4*(g%2)))&0x0f0f0f0fu;
    return t==13 ? lo|(((word(off+16+j)>>g)&0x01010101u)<<4) : lo;
