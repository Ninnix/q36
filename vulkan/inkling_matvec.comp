        grid=t==16 ? tables[2*byte_at(off+2+8*g+sub)+lane%2] :
             tables[3104+byte_at(off+2+8*g+lane)];
    } else {
        uint entry;
        if (t==17) {
            uint packed=halfword(off+2+8*g+2*sub);
            entry=packed&511u; signs=sign_bits(packed>>9);
        } else {
            entry=byte_at(off+2+4*g+sub)|((byte_at(off+66+g)<<(8-2*sub))&768u);
            signs=byte_at(off+34+4*g+sub);
        }
        sc=(byte_at(off+(t==17 ? 66 : 74)+g)>>(4*(sub/2)))&15u;
        grid=tables[(t==17 ? 7456 : 544)+2*entry+lane%2];
