#ifdef INK_FMA
        v+=subgroupShuffleXor(v,4); v+=subgroupShuffleXor(v,2); v+=subgroupShuffleXor(v,1);
#else
        sums[l]=v; barrier();
        if (lane==0) v=((sums[l]+sums[l+4])+(sums[l+2]+sums[l+6]))+
                       ((sums[l+1]+sums[l+5])+(sums[l+3]+sums[l+7]));
        barrier();
#endif
        if (lane==0 && id[t]!=~0u) y[id[t]*p.rows+row+8*r]=TYPE==18 ? v*0.25 : v;
    }
}

