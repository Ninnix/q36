// IQ4_NL folds the block scales left to right. Compute independent block
// products in parallel, then give one lane each ordered row/token sum.
shared float pieces[TYPE==20 && WIDTH==1152 ? 64*(WIDTH/32) : 1];
void iq4_tile() {
    uint l=gl_LocalInvocationID.x, tile=gl_WorkGroupID.x/8, nt=p.route>>8;
    uint first=(gl_WorkGroupID.y*8+gl_WorkGroupID.x%8)*8, row=first+l/8;
    uint mode=p.route&15u, desc=16*nt+1+9*tile;
    if (first>=p.rows || (mode!=0 && tile>=ids[16*nt])) return;
    wbase=mode!=0 ? (ids[desc]&127u)*p.rows*p.stride : 0;
    [[unroll]] for (uint t=0;t<8;t++) {
        path[t]=mode!=0 ? ids[desc+1+t] : 8*tile+t<nt ? 8*tile+t : ~0u;
        uint id=path[t]==~0u ? path[0] : path[t];
        input_base[t]=(mode==1 ? id/8 : id)*(WIDTH/32)*9;
    }
    for (uint b=l%8;b<WIDTH/32;b+=8) {
        uint base=wbase/4+row*(p.stride/4);
        int weights[8];
        [[unroll]] for (uint k=0;k<8;k++) weights[k]=iq4_weight(base,b,k);
        float scale=iq4_scale(base,b);
        [[unroll]] for (uint t=0;t<8;t++) {
            uint at=input_base[t]+9*b;
            int dot=0;
            [[unroll]] for (uint k=0;k<8;k++) dot+=dot4(int(weights[k]),x[at+1+k]);
            precise float product=(float(dot)*unpackHalf2x16(x[at]).x)*scale;
            pieces[((l/8)*8+t)*(WIDTH/32)+b]=product;
        }
    }
    barrier();
    if (path[l%8]!=~0u) {
        precise float sum=0;
        for (uint b=0;b<WIDTH/32;b++) sum+=pieces[l*(WIDTH/32)+b];
        y[path[l%8]*p.rows+row]=sum;
    }
}

int tile_weight(uint row,uint b,uint group,uint lane,bool iq,uint bytes,out int mult,inout float scale) {
    if (iq) {
        uint off=row*p.stride+b*bytes, sc;
        int weight=iq_grid(TYPE,off,row,b,group,lane,sc);
        mult=int(2*sc+1);
        if (group==0) scale=iq_scale(row,b,bytes,off)*(TYPE==18 ? 1 : 0.125);
        return weight;
    }
    uint weight;
    packed_block(row,lane,b,weight,scale);
    mult=1;
    return int(weight);
}

#ifdef INK_HALF_WEIGHT
f16vec4 fp4_components(uint codes) {
    return f16vec4(unpackHalf2x16(tables[12032+(codes&255u)]),
                   unpackHalf2x16(tables[12032+((codes>>8)&255u)]));
}

vec2 fp4_pair_dot(f16vec4 w,f16vec2 x[4]) {
    // An odd sum of two products is at most 128*(12+3).
    // Every larger sum is even and still exact in binary16.
    f16vec2 lo=fma(f16vec2(w.y),x[1],f16vec2(w.x)*x[0]);
    f16vec2 hi=fma(f16vec2(w.w),x[3],f16vec2(w.z)*x[2]);
    return vec2(lo)+vec2(hi);
}
#endif

vec4 tile_components(uint row,uint b,uint g,uint lane,bool iq,uint bytes,inout float scale) {
#ifdef INK_FMA
    if (TYPE==18) {
        uint signs,sc,grid=iq_index(TYPE,row,b,g,lane,signs,sc);
        uint pairs=tables[12288+grid-1536], base=12544+256*sc;
        if (g==0) scale=iq_scale(row,b,bytes,row*p.stride+b*bytes);
        return vec4(unpackHalf2x16(tables[base+64*(signs&3)+(pairs&63)]),
                    unpackHalf2x16(tables[base+64*(signs>>2)+(pairs>>6)]));
    }
#endif
#ifdef INK_HALF_WEIGHT
    if (iq || TYPE==40) {
        uvec2 bits;
        float16_t factor=float16_t(1);
        if (iq) {
            uint signs, sc, grid=iq_index(TYPE,row,b,g,lane,signs,sc);
            uint base=4352+2*grid;
            bits=uvec2(tables[base],tables[base+1]);
            bits^=(uvec2(signs,signs>>2)*0x40008000u)&0x80008000u;
            factor=float16_t(2*sc+1);
            if (g==0) scale=iq_scale(row,b,bytes,row*p.stride+b*bytes)*(TYPE==18 ? 1 : 0.125);
        } else return vec4(fp4_components(fp4_codes(row,lane,b,scale)));
        f16vec2 lo=f16vec2(unpackHalf2x16(bits.x)), hi=f16vec2(unpackHalf2x16(bits.y));
        return vec4(vec2(lo*factor),vec2(hi*factor));
    }
#endif
    int mult, codes=tile_weight(row,b,g,lane,iq,bytes,mult,scale);
    vec4 weight;
    [[unroll]] for (uint k=0;k<4;k++) weight[k]=float(bitfieldExtract(codes,int(8*k),8)*mult);
    return weight;
}

// Q8 integers are exact in half precision. Even the largest scaled IQ lane
// sum (32 * 128 * 62 * 31) is exact in binary32. Only the block rescaling
// needs the rounded FMA and the eight-lane reduction used by the CPU.
void paired_tile(uint paths,uint rows) {
    uint l=gl_LocalInvocationID.x, lane=l%8, tile=gl_WorkGroupID.x/8;
    uint row=(gl_WorkGroupID.y*8+gl_WorkGroupID.x%8)*(8*rows)+l/8, nt=p.route>>8;
    if (row>=p.rows) return;
    bool routed=(p.route&15u)!=0, iq=TYPE!=40 && TYPE!=8;
    if (!routed && paths==16) tile*=2;
    uint desc=16*nt+1+9*tile, blocks=WIDTH/(iq ? 256 : 32), groups=iq ? 8 : 1;
    uint bytes=TYPE==16 ? 66 : TYPE==17 ? 74 : TYPE==18 ? 98 : 82;
    wbase=routed ? (ids[desc]&127u)*p.rows*p.stride : 0;
    uint id[16];
    [[unroll]] for (uint t=0;t<paths;t++)
        id[t]=routed ? ids[desc+1+t+t/8] : 8*tile+t<nt ? 8*tile+t : ~0u;
    float result[4][16];
    [[unroll]] for (uint r=0;r<rows;r++) [[unroll]] for (uint t=0;t<paths;t++) result[r][t]=0;
    for (uint b=0;b<blocks;b++) {
        uint xb=(tile*blocks+b)*(8+128*groups);
        float dots[4][16], scales[4];
        [[unroll]] for (uint r=0;r<rows;r++) [[unroll]] for (uint t=0;t<paths;t++) dots[r][t]=0;
#ifdef INK_IQ_TILE_I16
        [[unroll]] for (uint r=0;r<rows;r++) {
            uint out_row=row+8*r;
            scales[r]=iq_scale(out_row,b,bytes,out_row*p.stride+b*bytes)*(TYPE==18 ? 1 : 0.125);
        }
        [[dont_unroll]] for (uint g0=0;g0<8;g0+=2) [[unroll]] for (uint gg=0;gg<2;gg++) {
            uint g=g0+gg;
            i16vec4 weights[4];
            float mult[4];
            [[unroll]] for (uint r=0;r<rows;r++) {
                uint sc, out_row=row+8*r;
                int codes=iq_grid(TYPE,out_row*p.stride+b*bytes,out_row,b,g,lane,sc);
                [[unroll]] for (int k=0;k<4;k++) weights[r][k]=int16_t(bitfieldExtract(codes,8*k,8));
                mult[r]=float(2*sc+1);
            }
            [[unroll]] for (uint t=0;t<paths/2;t++) {
                uint at=xb+(t/4)*blocks*(8+128*groups)+8+128*g+32*(t%4)+lane;
                i16vec2 act[4];
                [[unroll]] for (uint k=0;k<4;k++) act[k]=unpackInt2x16(int(x[at+8*k]));
                [[unroll]] for (uint r=0;r<rows;r++) {
                    // Four unscaled IQ3 products fit in a signed 16-bit lane.
                    i16vec2 dot=i16vec2(0);
                    [[unroll]] for (uint k=0;k<4;k++) dot+=i16vec2(weights[r][k])*act[k];
                    dots[r][2*t]=ink_fma(mult[r],float(dot.x),dots[r][2*t]);
                    dots[r][2*t+1]=ink_fma(mult[r],float(dot.y),dots[r][2*t+1]);
                }
            }
        }
#else
        [[unroll]] for (uint g=0;g<groups;g++) {
            vec4 weight[4];
            [[unroll]] for (uint r=0;r<rows;r++)
                weight[r]=tile_components(row+8*r,b,g,lane,iq,bytes,scales[r]);
            [[unroll]] for (uint t=0;t<paths/2;t++) {
                uint at=xb+(t/4)*blocks*(8+128*groups)+8+128*g+32*(t%4)+lane;
#ifdef INK_HALF_WEIGHT
                if (TYPE==40) {
                    f16vec2 act[4];
                    [[unroll]] for (uint k=0;k<4;k++) act[k]=f16vec2(unpackHalf2x16(x[at+8*k]));
                    [[unroll]] for (uint r=0;r<rows;r++) {
                        vec2 v=fp4_pair_dot(f16vec4(weight[r]),act);
                        dots[r][2*t]=v.x; dots[r][2*t+1]=v.y;
                    }
                } else
#endif
                [[unroll]] for (uint k=0;k<4;k++) {
                    vec2 act=unpackHalf2x16(x[at+8*k]);
                    [[unroll]] for (uint r=0;r<rows;r++) {
                        dots[r][2*t]=fma(weight[r][k],act.x,dots[r][2*t]);
                        dots[r][2*t+1]=fma(weight[r][k],act.y,dots[r][2*t+1]);
                    }
                }
            }
        }
#endif
        [[unroll]] for (uint t=0;t<paths;t++) {
            float scale=uintBitsToFloat(x[xb+(t/8)*blocks*(8+128*groups)+t%8]);
            [[unroll]] for (uint r=0;r<rows;r++) result[r][t]=ink_fma(scales[r]*scale,dots[r][t],result[r][t]);
