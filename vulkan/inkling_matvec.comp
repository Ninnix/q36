// Pair consecutive uses of an expert in a verification block. An unmatched
// route uses the ordinary single-input dot product.
uint expertPartner(uint path,uint expert) {
    uint i=gl_SubgroupInvocationID;
    uvec4 hits=subgroupBallot(i<8*gl_NumWorkGroups.z && ids[16*(i/8)+i%8]==expert);
    uint word=path/32, bit=1u<<(path%32);
    uint before=bitCount(hits[word]&(bit-1u));
    if (word!=0) before+=bitCount(hits.x);
    if ((before&1u)!=0) return ~0u;
    if (word!=0) hits.x=0;
    hits[word]&=~((bit-1u)|bit);
    if (hits.x!=0) return uint(findLSB(hits.x));
    if (hits.y!=0) return 32+uint(findLSB(hits.y));
    return path;
}
// Each routed input has its own Q8 scale. The pair shares the FP4 unpack.
shared uint fp4_decode[TYPE==40 ? 256 : 1];
int nvWeights(uint bits) {
    return int(fp4_decode[bits&255u]|(fp4_decode[(bits>>8)&255u]<<16));
