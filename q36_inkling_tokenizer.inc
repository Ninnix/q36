static uint32_t utf8_decode_one(const char *s, uint64_t len, uint64_t *pos);

static unsigned ink_char(const char *s, uint64_t len, uint64_t pos) {
    if (pos >= len) return 0;
    uint32_t cp = utf8_decode_one(s,len,&pos);
    uint32_t lo = 0, hi = sizeof(ink_ranges)/sizeof(*ink_ranges);
    while (hi-lo > 1) {
        unsigned mid = (lo+hi)/2;
        if (cp < (ink_ranges[mid] >> 2)) hi = mid;
        else lo = mid;
    }
    return ink_ranges[lo] & 3;
}

static void ink_tokenize(const q36_vocab *v, const char *s, token_vec *out) {
    uint64_t n = strlen(s), end = 0;
    while (end < n) {
        uint64_t start = end, next = next_utf8_char(s,n,start);
        unsigned c = ink_char(s,n,start);
        bool prefix = c != 1 && c != 2 && !ascii_newline(s[start]) && ink_char(s,n,next) == 1;
        if (c == 1 || prefix) {
            end = prefix ? next : start;
            /* The GGUF's GPT-4o regex splits a lowercase run before the
             * next ASCII capital. Non-ASCII letters match either case. */
            while (end < n && ink_char(s,n,end) == 1 && !(s[end] >= 'a' && s[end] <= 'z'))
                end = next_utf8_char(s,n,end);
            while (end < n && ink_char(s,n,end) == 1 && !(s[end] >= 'A' && s[end] <= 'Z'))
                end = next_utf8_char(s,n,end);
            qwen_match_suffix(s,n,end,&end);
        } else if (c == 2) {
            end = next;
            for (int j = 1; j < 3 && ink_char(s,n,end) == 2; j++) end = next_utf8_char(s,n,end);
        } else if (!c || (s[start] == ' ' && next < n && !ink_char(s,n,next))) {
            end = next;
            while (end < n && !ink_char(s,n,end)) end = next_utf8_char(s,n,end);
            while (end < n && (ascii_newline(s[end]) || s[end] == '/')) end++;
        } else {
            uint64_t newline = 0, last = start;
            while (end < n && ink_char(s,n,end) == 3) {
                last = end;
                end = next_utf8_char(s,n,end);
                if (ascii_newline(s[last])) newline = end;
            }
            if (newline) end = newline;
            else if (end < n && last != start) end = last;
        }
        bpe_emit_piece(v,(q36_str){s+start,end-start},out);
    }
}
